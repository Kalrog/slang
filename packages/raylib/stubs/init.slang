//   C: Vector2 GetScreenToWorld2D(Vector2 position, Camera2D camera)
func m.screen_to_world_2d(position, camera){ return {x: 0, y: 0} }

// Get a ray trace from screen position (i.e mouse)
//   screen_to_world_ray(position: Vector2, camera: Camera3D) -> Ray
//   C: Ray GetScreenToWorldRay(Vector2 position, Camera3D camera)
func m.screen_to_world_ray(position, camera){ return {position: {x: 0, y: 0, z: 0}, direction: {x: 0, y: 0, z: 0}} }

// Get a ray trace from screen position (i.e mouse) in a viewport
//   screen_to_world_ray_ex(position: Vector2, camera: Camera3D, width: int,
