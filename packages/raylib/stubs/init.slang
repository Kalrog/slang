// Get (evaluate) spline point: B-Spline
//   spline_point_basis(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, t:
//      float) -> Vector2
//   C: Vector2 GetSplinePointBasis(Vector2 p1, Vector2 p2, Vector2 p3, Vector2
//      p4, float t)
func m.spline_point_basis(p1, p2, p3, p4, t){ return {x: 0, y: 0} }

// Get (evaluate) spline point: Cubic Bezier
//   spline_point_bezier_cubic(p1: Vector2, c2: Vector2, c3: Vector2, p4:
//      Vector2, t: float) -> Vector2
//   C: Vector2 GetSplinePointBezierCubic(Vector2 p1, Vector2 c2, Vector2 c3,
//      Vector2 p4, float t)
func m.spline_point_bezier_cubic(p1, c2, c3, p4, t){ return {x: 0, y: 0} }

// Get (evaluate) spline point: Quadratic Bezier
//   spline_point_bezier_quad(p1: Vector2, c2: Vector2, p3: Vector2, t: float)
//      -> Vector2
//   C: Vector2 GetSplinePointBezierQuad(Vector2 p1, Vector2 c2, Vector2 p3,
//      float t)
func m.spline_point_bezier_quad(p1, c2, p3, t){ return {x: 0, y: 0} }

// Get (evaluate) spline point: Catmull-Rom
//   spline_point_catmull_rom(p1: Vector2, p2: Vector2, p3: Vector2, p4:
//      Vector2, t: float) -> Vector2
//   C: Vector2 GetSplinePointCatmullRom(Vector2 p1, Vector2 p2, Vector2 p3,
//      Vector2 p4, float t)
func m.spline_point_catmull_rom(p1, p2, p3, p4, t){ return {x: 0, y: 0} }

// Get (evaluate) spline point: Linear
//   spline_point_linear(start_pos: Vector2, end_pos: Vector2, t: float) ->
//      Vector2
//   C: Vector2 GetSplinePointLinear(Vector2 startPos, Vector2 endPos, float t)
func m.spline_point_linear(start_pos, end_pos, t){ return {x: 0, y: 0} }

