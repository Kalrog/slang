// The kernels of bench.slang: each loop as bench.slang writes it in slang.

kernel func saw(out: float[], n: int, phase: float, inc: float): float {
  for(local i = 0; i < n; i += 1){
    phase += inc
    if(phase >= 1.0){
      phase -= 1.0
    }
    out[i] = phase * 2 - 1
  }
  return phase
}

// six sine operators in a chain, each modulating the phase of the next (an
// FM voice's stack)
struct Op { phase: double, inc: double, level: double }

kernel func chain(out: float[], ops: Op[], n: int){
  for(local i = 0; i < n; i += 1){
    local m = 0.0
    for(local k = 5; k >= 0; k -= 1){
      local op = ops[k]
      local p = op.phase + op.inc
      if(p >= 1.0){
        p -= 1.0
      }
      op.phase = p
      m = sin((p + m) * TAU) * op.level
    }
    out[i] = m
  }
}

// a four-pole ladder low-pass, its state in st (y1..y4)
kernel func ladder(io: float[], n: int, g: float, k: float, st: double[]){
  local y1 = st[0]
  local y2 = st[1]
  local y3 = st[2]
  local y4 = st[3]
  for(local i = 0; i < n; i += 1){
    local u = tanh(io[i] - k * y4)
    y1 += g * (u - y1)
    y2 += g * (y1 - y2)
    y3 += g * (y2 - y3)
    y4 += g * (y3 - y4)
    io[i] = y4
  }
  st[0] = y1
  st[1] = y2
  st[2] = y3
  st[3] = y4
}
