// Writes units/six/render.kernel: one render kernel per algorithm of
// algorithms.slang, the voice's six operators wired as the algorithm says.
// Run from packages/studio after changing the six unit's algorithms or the
// render code here.
//
//   ../../bin/slang run tool/gen_six.slang
local str = require("slang/string")
local os = require("slang/os")
local algorithms = require("studio/units/six/algorithms")

// a single carrier at full level, before the voice's share of the mix
local CARRIER_GAIN = 0.25

// the render kernel of algorithm number a: "render<a>"
local func render_source(a, number){
  local alg = algorithms.get(number)
  local lines = {}
  local func add(...parts){
    local s = ""
    for(let local p in values(parts)){
      s = concat(s, string(p))
    }
    append(lines, s)
  }
  add(
    "func render", number,
    "(out: float[], ops: OpState[], voices: Voice[], v: int, n: int){"
  )
  add("  local b = v * 6")
  for(local k = 1; k <= 6; k = k + 1){
    add("  local o", k, " = ops[b + ", k - 1, "]")
    add("  local p", k, " = o", k, ".phase")
    add("  local i", k, " = o", k, ".inc")
    add("  local a", k, " = o", k, ".amp")
    add("  local d", k, " = o", k, ".damp")
  }
  add("  local vo = voices[v]")
  add("  local y1 = vo.y1")
  add("  local y2 = vo.y2")
  add("  local fb = vo.fb")
  add("  for(local i = 0; i < n; i += 1){")
  for(local k = 6; k >= 1; k = k - 1){
    // the phase offset: the modulators' outputs, and the feedback
    local inputs = {}
    for(let local m in values(alg.mods[k])){
      append(inputs, concat("x", string(m)))
    }
    if(alg.fb_to == k){
      append(inputs, "(y1 + y2) * fb")
    }
    local phase = concat("p", string(k))
    if(len(inputs) > 0){
      phase = concat("p", string(k), " + ", str.join(inputs, " + "))
    }
    add("    p", k, " = fract(p", k, " + i", k, ")")
    add("    local x", k, " = sin((", phase, ") * TAU) * a", k)
    add("    a", k, " += d", k)
    if(alg.fb_from == k){
      add("    y2 = y1")
      add("    y1 = x", k)
    }
  }
  local carriers = {}
  for(let local c in values(alg.carriers)){
    append(carriers, concat("x", string(c)))
  }
  // the carriers share the voice's level: more of them, each softer
  local gain = CARRIER_GAIN / (len(alg.carriers) ^ 0.5)
  add("    out[i] += (", str.join(carriers, " + "), ") * ", gain)
  add("  }")
  for(local k = 1; k <= 6; k = k + 1){
    add("  o", k, ".phase = p", k)
    add("  o", k, ".amp = a", k)
  }
  add("  vo.y1 = y1")
  add("  vo.y2 = y2")
  add("}")
  return str.join(lines, "\n")
}

local parts = {
  """// Generated by tool/gen_six.slang from algorithms.slang: do not edit.
// render<a>(out, ops, voices, v, n): voice v's six operators wired as
// algorithm a, n samples added into out.
use "studio/units/six/voice"
""",
}
for(local a = 1; a <= algorithms.count; a = a + 1){
  append(parts, render_source(a, a))
}
os.write_file("units/six/render.kernel", concat(str.join(parts, "\n"), "\n"))
print("units/six/render.kernel: ", algorithms.count, " render kernels\n")
