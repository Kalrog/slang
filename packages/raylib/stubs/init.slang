// ------------------------------------------------------------ rl.font

// default(self) -> Font
// Get the default Font
// C: GetFontDefault
func ns_font_get.default(self){ return {@meta: font_meta, base_size: 0, glyph_count: 0, glyph_padding: 0, texture: {id: 0, width: 0, height: 0, mipmaps: 0, format: 0}, recs: null, glyphs: null} }

// Export font as code file, returns true on success
//   export_as_code(font: Font, file_name: string) -> bool
//   C: bool ExportFontAsCode(Font font, const char *fileName)
func ns_font_fns.export_as_code(font, file_name){}

// Load font from file into GPU memory (VRAM)
//   load(file_name: string) -> Font
//   C: Font LoadFont(const char *fileName)
func ns_font_fns.load(file_name){ return {@meta: font_meta, base_size: 0, glyph_count: 0, glyph_padding: 0, texture: {id: 0, width: 0, height: 0, mipmaps: 0, format: 0}, recs: null, glyphs: null} }

// Load font data for further use
//   load_data(file_data: string, font_size: int, codepoints: list, type: int)
//      -> GlyphInfo (updated)
//   C: GlyphInfo *LoadFontData(const unsigned char *fileData, int dataSize, int
//      fontSize, int *codepoints, int codepointCount, int type)
func ns_font_fns.load_data(file_data, font_size, codepoints, type){}

// Load font from file with extended parameters, use NULL for codepoints and 0
// for codepointCount to load the default character set, font size is provided
// in pixels height
//   load_ex(file_name: string, font_size: int, codepoints: list) -> Font
//   C: Font LoadFontEx(const char *fileName, int fontSize, int *codepoints, int
//      codepointCount)
func ns_font_fns.load_ex(file_name, font_size, codepoints){ return {@meta: font_meta, base_size: 0, glyph_count: 0, glyph_padding: 0, texture: {id: 0, width: 0, height: 0, mipmaps: 0, format: 0}, recs: null, glyphs: null} }

// Load font from Image (XNA style)
//   load_from_image(image: Image, key: Color, first_char: int) -> Font
//   C: Font LoadFontFromImage(Image image, Color key, int firstChar)
func ns_font_fns.load_from_image(image, key, first_char){ return {@meta: font_meta, base_size: 0, glyph_count: 0, glyph_padding: 0, texture: {id: 0, width: 0, height: 0, mipmaps: 0, format: 0}, recs: null, glyphs: null} }

// Load font from memory buffer, fileType refers to extension: i.e. '.ttf'
//   load_from_memory(file_type: string, file_data: string, font_size: int,
//      codepoints: list) -> Font
//   C: Font LoadFontFromMemory(const char *fileType, const unsigned char
//      *fileData, int dataSize, int fontSize, int *codepoints, int
//      codepointCount)
func ns_font_fns.load_from_memory(file_type, file_data, font_size, codepoints){ return {@meta: font_meta, base_size: 0, glyph_count: 0, glyph_padding: 0, texture: {id: 0, width: 0, height: 0, mipmaps: 0, format: 0}, recs: null, glyphs: null} }

// Unload font from GPU memory (VRAM)
//   unload(font: Font)
//   C: void UnloadFont(Font font)
func ns_font_fns.unload(font){}

// Unload font chars info data (RAM)
//   unload_data(glyphs: list of GlyphInfo)
//   C: void UnloadFontData(GlyphInfo *glyphs, int glyphCount)
func ns_font_fns.unload_data(glyphs){}

// Check if a font is valid (font data loaded, WARNING: GPU texture not checked)
//   valid(font: Font) -> bool
//   C: bool IsFontValid(Font font)
func ns_font_fns.valid(font){}

