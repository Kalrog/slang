// render/map_picture: the kernel of the map's picture (render/map calls
// it): the land from above as a walker's map draws it, its ground in the
// colors of what covers it, shaded as if lit from the north west, with a
// contour line every ten meters of height (every fifty a darker one) and
// the water in blue; or (style 1) as a contour map: the lines alone, in
// brown on a calm paper, every fifty meters a heavier one, the water
// blue, rock and snow only a shade of the paper.

// what one share of the cover looks like on the map, by its place among
// the eight shares (rock, scree, dirt, mud, sand, snow, forest floor,
// grass): red, green and blue
local func tone(k: int, c: int): float {
  local r = select(k == 0, 170.0, select(k == 1, 182.0, select(k == 2, 172.0, select(k == 3, 128.0,
    select(k == 4, 206.0, select(k == 5, 240.0, select(k == 6, 112.0, 150.0)))))))
  local g = select(k == 0, 162.0, select(k == 1, 174.0, select(k == 2, 150.0, select(k == 3, 108.0,
    select(k == 4, 190.0, select(k == 5, 243.0, select(k == 6, 128.0, 172.0)))))))
  local b = select(k == 0, 150.0, select(k == 1, 160.0, select(k == 2, 112.0, select(k == 3, 82.0,
    select(k == 4, 148.0, select(k == 5, 248.0, select(k == 6, 84.0, 104.0)))))))
  return select(c == 0, r, select(c == 1, g, b))
}

// topo: rows j0 to j1 of the picture (n by n pixels, one a sample, four
// bytes each; north up and the land's x growing to the left, as
// land.kernel's relief has it). cover and cover2 are the land's (see
// game/terrain's finish), shape its light (only how much sky a place
// sees is taken from it); covered 0: there are none yet, and the colors
// go by height and steepness alone.
func topo(j0: int, j1: int, image: uint8[], h: float[], water: float[], cover: uint8[],
  cover2: uint8[], shape: uint8[], covered: int, n: int, spacing: float, style: int){
  for(local j = j0; j < j1; j += 1){
    for(local i = 0; i < n; i += 1){
      local x = clamp(i, 1, n - 2)
      local z = clamp(j, 1, n - 2)
      local c = h[z * n + x]
      local gx = (h[z * n + x + 1] - h[z * n + x - 1]) / (2 * spacing)
      local gz = (h[(z + 1) * n + x] - h[(z - 1) * n + x]) / (2 * spacing)
      local slope = sqrt(gx * gx + gz * gz)
      local r = 0.0
      local g = 0.0
      local b = 0.0
      local at = (j * n + i) * 4
      if(covered == 1){
        local total = 0.0
        for(local k = 0; k < 8; k += 1){
          local share = float(select(k < 4, cover[at + k % 4], cover2[at + k % 4]))
          r += tone(k, 0) * share
          g += tone(k, 1) * share
          b += tone(k, 2) * share
          total += share
        }
        total = max(total, 1.0)
        r = r / total
        g = g / total
        b = b / total
      } else {
        local up = clamp(c / 420, 0, 1)
        r = mix(150.0, 170.0, up)
        g = mix(172.0, 166.0, up)
        b = mix(104.0, 140.0, up)
        local rock = smoothstep(0.7, 1.1, slope)
        r = mix(r, 148.0, rock)
        g = mix(g, 144.0, rock)
        b = mix(b, 138.0, rock)
      }
      // the light: from the north west (the map's top left: +z and +x),
      // high; and less of it where the land around shuts out the sky
      local l = 1 / sqrt(gx * gx + 1 + gz * gz)
      local lit = clamp((-gx * 0.5 - gz * 0.5 + 0.72) * l, 0, 1.2)
      local sky = 1.0
      if(covered == 1){
        sky = 0.7 + 0.3 * float(shape[at + 2]) / 255.0
      }
      local light = (0.7 + 0.4 * lit) * sky
      r *= light
      g *= light
      b *= light
      // the contours: a line where the height passes a tenth of the
      // hundred, as wide as a pixel, whatever the slope (and none where
      // the rock is so steep that they would run together)
      local f = c / 10.0
      local off = abs(f - floor(f + 0.5)) * 10.0
      local across = off / max(slope, 0.02) / spacing
      local line = 1 - smoothstep(0.25, 0.85, across)
      local index = select(abs(c / 50.0 - floor(c / 50.0 + 0.5)) * 50.0 < 2.0, 1.0, 0.0)
      line *= (1 - smoothstep(0.9, 1.7, slope)) * mix(0.17, 0.36, index)
      r *= 1 - line
      g *= 1 - line * 1.05
      b *= 1 - line * 1.25
      if(style == 1){
        // the contour map: paper, a little greyer on rock, whiter on snow,
        // barely shaded; the lines by how far the sample is from their
        // height, across the slope, so that they are a pixel wide (an
        // index line nearly two) wherever they run
        local rocky = 0.0
        local snowy = 0.0
        if(covered == 1){
          rocky = (float(cover[at]) + float(cover[at + 1])) / 255.0
          snowy = float(cover2[at + 1]) / 255.0
        } else {
          rocky = smoothstep(0.7, 1.1, slope)
        }
        rocky = 0.5 * rocky
        r = mix(mix(240.0, 226.0, rocky), 250.0, snowy)
        g = mix(mix(233.0, 222.0, rocky), 251.0, snowy)
        b = mix(mix(214.0, 212.0, rocky), 252.0, snowy)
        local shade = 0.93 + 0.08 * clamp(lit, 0, 1)
        r *= shade
        g *= shade
        b *= shade
        local fine = 1 - smoothstep(0.35, 0.95, across)
        local heavy = abs(c / 50.0 - floor(c / 50.0 + 0.5)) * 50.0 / max(slope, 0.02) / spacing
        local bold = 1 - smoothstep(0.7, 1.3, heavy)
        // (on cliffs the lines run together: the fine ones give way there)
        local ink = max(fine * 0.42 * (1 - smoothstep(1.4, 2.6, slope)), bold * 0.85)
        r = mix(r, 150.0, ink)
        g = mix(g, 104.0, ink)
        b = mix(b, 62.0, ink)
      }
      local wet = water[z * n + x] - c
      if(wet > -0.08){
        local deep = clamp(wet / 3, 0, 1)
        // (the edge of the water a little lighter, as the shallows are,
        // and blended into the bank over a few centimeters of depth, so
        // that its edge is not a stair of pixels)
        local k = smoothstep(-0.08, 0.2, wet)
        r = mix(r, mix(112.0, 58.0, deep), k)
        g = mix(g, mix(158.0, 108.0, deep), k)
        b = mix(b, mix(178.0, 150.0, deep), k)
      }
      local out = ((n - 1 - j) * n + (n - 1 - i)) * 4
      image[out] = int(clamp(r, 0, 255))
      image[out + 1] = int(clamp(g, 0, 255))
      image[out + 2] = int(clamp(b, 0, 255))
      image[out + 3] = 255
    }
  }
}
