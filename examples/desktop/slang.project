// async/await, the HTML templates and the sql{} literals are ambient in
// every file of the app
{
  // the repository root, so that extensions/... resolves wherever slang
  // runs from
  search_paths: {"../.."},
  extensions: {"extensions/async", "extensions/html", "extensions/sqlite"},
  // slang build --dir examples/desktop/main.slang
  build: {name: "todos", assets: {"static"}, compress: true},
}
