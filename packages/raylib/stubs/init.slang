//   C: Ray GetScreenToWorldRayEx(Vector2 position, Camera3D camera, int width,
//      int height)
func m.screen_to_world_ray_ex(position, camera, width, height){ return {position: {x: 0, y: 0, z: 0}, direction: {x: 0, y: 0, z: 0}} }

