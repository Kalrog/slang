//   divide(v1: Vector3, v2: Vector3) -> Vector3
//   C: Vector3 Vector3Divide(Vector3 v1, Vector3 v2)
func ns_vector3_fns.divide(v1, v2){ return {x: 0, y: 0, z: 0} }

// Calculate two vectors dot product
//   dot_product(v1: Vector3, v2: Vector3) -> float
//   C: float Vector3DotProduct(Vector3 v1, Vector3 v2)
func ns_vector3_fns.dot_product(v1, v2){}

// Check whether two given vectors are almost equal
//   equals(p: Vector3, q: Vector3) -> int
//   C: int Vector3Equals(Vector3 p, Vector3 q)
func ns_vector3_fns.equals(p, q){}

// Invert the given vector
