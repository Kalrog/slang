//   C: Matrix MatrixPerspective(double fovY, double aspect, double nearPlane,
//      double farPlane)
func ns_matrix_fns.perspective(fov_y, aspect, near_plane, far_plane){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Create rotation matrix from axis and angle NOTE: Angle should be provided in
// radians
//   rotate(axis: Vector3, angle: float) -> Matrix
//   C: Matrix MatrixRotate(Vector3 axis, float angle)
func ns_matrix_fns.rotate(axis, angle){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get x-rotation matrix NOTE: Angle must be provided in radians
