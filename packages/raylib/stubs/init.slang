// ------------------------------------------------------------ rl.quaternion

// Add two quaternions
//   add(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionAdd(Vector4 q1, Vector4 q2)
func ns_quaternion_fns.add(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Add quaternion and float value
//   add_value(q: Vector4, add: float) -> Vector4
//   C: Vector4 QuaternionAddValue(Vector4 q, float add)
func ns_quaternion_fns.add_value(q, add){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate quaternion cubic spline interpolation using Cubic Hermite Spline
// algorithm as described in the GLTF 2.0 specification:
// https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
//   cubic_hermite_spline(q1: Vector4, out_tangent1: Vector4, q2: Vector4,
//      in_tangent2: Vector4, t: float) -> Vector4
//   C: Vector4 QuaternionCubicHermiteSpline(Vector4 q1, Vector4 outTangent1,
//      Vector4 q2, Vector4 inTangent2, float t)
func ns_quaternion_fns.cubic_hermite_spline(q1, out_tangent1, q2, in_tangent2, t){ return {x: 0, y: 0, z: 0, w: 0} }

// Divide two quaternions
//   divide(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionDivide(Vector4 q1, Vector4 q2)
func ns_quaternion_fns.divide(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Check whether two given quaternions are almost equal
//   equals(p: Vector4, q: Vector4) -> int
//   C: int QuaternionEquals(Vector4 p, Vector4 q)
func ns_quaternion_fns.equals(p, q){}

// Get rotation quaternion for an angle and axis NOTE: Angle must be provided in
// radians
//   from_axis_angle(axis: Vector3, angle: float) -> Vector4
//   C: Vector4 QuaternionFromAxisAngle(Vector3 axis, float angle)
func ns_quaternion_fns.from_axis_angle(axis, angle){ return {x: 0, y: 0, z: 0, w: 0} }

// Get the quaternion equivalent to Euler angles NOTE: Rotation order is ZYX
//   from_euler(pitch: float, yaw: float, roll: float) -> Vector4
//   C: Vector4 QuaternionFromEuler(float pitch, float yaw, float roll)
func ns_quaternion_fns.from_euler(pitch, yaw, roll){ return {x: 0, y: 0, z: 0, w: 0} }

// Get a quaternion for a given rotation matrix
//   from_matrix(mat: Matrix) -> Vector4
//   C: Vector4 QuaternionFromMatrix(Matrix mat)
func ns_quaternion_fns.from_matrix(mat){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate quaternion based on the rotation from one vector to another
//   from_vector3_to_vector3(from: Vector3, to: Vector3) -> Vector4
//   C: Vector4 QuaternionFromVector3ToVector3(Vector3 from, Vector3 to)
func ns_quaternion_fns.from_vector3_to_vector3(from, to){ return {x: 0, y: 0, z: 0, w: 0} }

// Get identity quaternion
//   identity() -> Vector4
//   C: Vector4 QuaternionIdentity()
func ns_quaternion_fns.identity(){ return {x: 0, y: 0, z: 0, w: 0} }

// Invert provided quaternion
//   invert(q: Vector4) -> Vector4
//   C: Vector4 QuaternionInvert(Vector4 q)
func ns_quaternion_fns.invert(q){ return {x: 0, y: 0, z: 0, w: 0} }

// Computes the length of a quaternion
//   length(q: Vector4) -> float
//   C: float QuaternionLength(Vector4 q)
func ns_quaternion_fns.length(q){}

// Calculate linear interpolation between two quaternions
//   lerp(q1: Vector4, q2: Vector4, amount: float) -> Vector4
//   C: Vector4 QuaternionLerp(Vector4 q1, Vector4 q2, float amount)
func ns_quaternion_fns.lerp(q1, q2, amount){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate two quaternion multiplication
//   multiply(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionMultiply(Vector4 q1, Vector4 q2)
func ns_quaternion_fns.multiply(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate slerp-optimized interpolation between two quaternions
//   nlerp(q1: Vector4, q2: Vector4, amount: float) -> Vector4
//   C: Vector4 QuaternionNlerp(Vector4 q1, Vector4 q2, float amount)
func ns_quaternion_fns.nlerp(q1, q2, amount){ return {x: 0, y: 0, z: 0, w: 0} }

// Normalize provided quaternion
//   normalize(q: Vector4) -> Vector4
//   C: Vector4 QuaternionNormalize(Vector4 q)
func ns_quaternion_fns.normalize(q){ return {x: 0, y: 0, z: 0, w: 0} }

// Scale quaternion by float value
//   scale(q: Vector4, mul: float) -> Vector4
//   C: Vector4 QuaternionScale(Vector4 q, float mul)
func ns_quaternion_fns.scale(q, mul){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculates spherical linear interpolation between two quaternions
//   slerp(q1: Vector4, q2: Vector4, amount: float) -> Vector4
//   C: Vector4 QuaternionSlerp(Vector4 q1, Vector4 q2, float amount)
func ns_quaternion_fns.slerp(q1, q2, amount){ return {x: 0, y: 0, z: 0, w: 0} }

// Subtract two quaternions
//   subtract(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionSubtract(Vector4 q1, Vector4 q2)
func ns_quaternion_fns.subtract(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Subtract quaternion and float value
//   subtract_value(q: Vector4, sub: float) -> Vector4
//   C: Vector4 QuaternionSubtractValue(Vector4 q, float sub)
func ns_quaternion_fns.subtract_value(q, sub){ return {x: 0, y: 0, z: 0, w: 0} }

// Get the rotation angle and axis for a given quaternion
//   to_axis_angle(q: Vector4, out_axis: Vector3 (updated), out_angle: pointer)
//   C: void QuaternionToAxisAngle(Vector4 q, Vector3 *outAxis, float *outAngle)
func ns_quaternion_fns.to_axis_angle(q, out_axis, out_angle){}

// Get the Euler angles equivalent to quaternion (roll, pitch, yaw) NOTE: Angles
// are returned in a Vector3 struct in radians
//   to_euler(q: Vector4) -> Vector3
//   C: Vector3 QuaternionToEuler(Vector4 q)
func ns_quaternion_fns.to_euler(q){ return {x: 0, y: 0, z: 0} }

// Get a matrix for a given quaternion
//   to_matrix(q: Vector4) -> Matrix
//   C: Matrix QuaternionToMatrix(Vector4 q)
func ns_quaternion_fns.to_matrix(q){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Transform a quaternion given a transformation matrix
//   transform(q: Vector4, mat: Matrix) -> Vector4
//   C: Vector4 QuaternionTransform(Vector4 q, Matrix mat)
func ns_quaternion_fns.transform(q, mat){ return {x: 0, y: 0, z: 0, w: 0} }

