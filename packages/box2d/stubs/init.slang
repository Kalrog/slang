// replay_step_frame(player: ffi.Pointer) -> bool
// Advance the replay by one recorded step. Returns true if a step executed,
// false once the end of the recording is reached
// C: `bool b2Replay_StepFrame(b2Replay *player)`
func m.replay_step_frame(player){}

// replay_get_world_id(player: ffi.Pointer) -> World
// Get the id of the replayed world.
// C: `b2WorldId b2Replay_GetWorldId(const b2Replay *player)`
func m.replay_get_world_id(player){}

// replay_restart(player: ffi.Pointer)
// Rewind the player to the first step, recreating the replay world from the
// file.
// C: `void b2Replay_Restart(b2Replay *player)`
func m.replay_restart(player){}

// replay_seek_frame(player: ffi.Pointer, target_frame: int)
// Seek to a recorded step. Seeking backward rewinds and re-runs from the
// nearest keyframe. Clamps to the recording bounds.
// C: `void b2Replay_SeekFrame(b2Replay *player, int targetFrame)`
func m.replay_seek_frame(player, target_frame){}

// replay_get_frame(player: ffi.Pointer) -> int
// Get the number of steps replayed so far.
// C: `int b2Replay_GetFrame(const b2Replay *player)`
func m.replay_get_frame(player){}

// replay_get_info(player: ffi.Pointer) -> ReplayInfo
// Get static metadata for the recording (frame count, recorded tuning, time).
// C: `b2ReplayInfo b2Replay_GetInfo(const b2Replay *player)`
func m.replay_get_info(player){}

// replay_is_at_end(player: ffi.Pointer) -> bool
// Returns true once the end of the recording has been reached.
// C: `bool b2Replay_IsAtEnd(const b2Replay *player)`
func m.replay_is_at_end(player){}

// replay_has_diverged(player: ffi.Pointer) -> bool
// Returns true if a recorded state hash failed to reproduce, meaning replay
// diverged.
// C: `bool b2Replay_HasDiverged(const b2Replay *player)`
func m.replay_has_diverged(player){}

// replay_get_diverge_frame(player: ffi.Pointer) -> int
// Get the first step at which replay diverged, or -1 if it has not diverged.
// C: `int b2Replay_GetDivergeFrame(const b2Replay *player)`
func m.replay_get_diverge_frame(player){}

// replay_set_keyframe_policy(player: ffi.Pointer, budget_bytes: int,
//   min_interval_frames: int)
// Tune the keyframe ring used to speed up backward seeking. A keyframe is a
// periodic snapshot the player restores from instead of replaying from the
// start, trading memory for seek speed.
// C: `void b2Replay_SetKeyframePolicy(b2Replay *player, size_t budgetBytes, int
// minIntervalFrames)`
// [player]: the recording player
// [budget_bytes]: Memory cap for the kept snapshots. The spacing widens to stay
//   under it.
// [min_interval_frames]: Finest spacing between keyframes, in frames.
func m.replay_set_keyframe_policy(player, budget_bytes, min_interval_frames){}

// replay_get_keyframe_budget(player: ffi.Pointer) -> int
// Get the keyframe memory budget in bytes.
// C: `size_t b2Replay_GetKeyframeBudget(const b2Replay *player)`
func m.replay_get_keyframe_budget(player){}

// replay_get_keyframe_min_interval(player: ffi.Pointer) -> int
// Get the finest keyframe spacing in frames.
// C: `int b2Replay_GetKeyframeMinInterval(const b2Replay *player)`
func m.replay_get_keyframe_min_interval(player){}

// replay_get_keyframe_interval(player: ffi.Pointer) -> int
// Get the current keyframe spacing in frames. Starts at the min interval and
// doubles as the ring evicts to stay under budget, so it reflects the effective
// backward-seek granularity right now.
// C: `int b2Replay_GetKeyframeInterval(const b2Replay *player)`
func m.replay_get_keyframe_interval(player){}

// replay_get_keyframe_bytes(player: ffi.Pointer) -> int
// Get the memory currently held by keyframe snapshots, in bytes.
// C: `size_t b2Replay_GetKeyframeBytes(const b2Replay *player)`
func m.replay_get_keyframe_bytes(player){}

// replay_draw_frame_queries(player: ffi.Pointer, draw?: ffi.Pointer,
//   query_index: int)
// Draw spatial queries recorded during the most recently replayed frame. Call
// after b2World_Draw so queries are layered on top of the world.
// C: `void b2Replay_DrawFrameQueries(b2Replay *player, b2DebugDraw *draw, int
// queryIndex)`
// [player]: A valid player handle
// [draw]: Debug draw callbacks. NULL draw function pointers are skipped.
// [query_index]: Index into the frame's queries to draw, or -1 to draw all of
//   them.
func m.replay_draw_frame_queries(player, draw, query_index){}

// replay_get_frame_query_count(player: ffi.Pointer) -> int
// Get the number of spatial queries recorded for the most recently replayed
// frame.
// C: `int b2Replay_GetFrameQueryCount(const b2Replay *player)`
func m.replay_get_frame_query_count(player){}

// replay_get_frame_query(player: ffi.Pointer, index: int) -> ReplayQueryInfo
// Get a recorded query from the most recently replayed frame by index.
// C: `b2ReplayQueryInfo b2Replay_GetFrameQuery(const b2Replay *player, int
// index)`
func m.replay_get_frame_query(player, index){}

// replay_get_frame_query_hit(player: ffi.Pointer, query_index: int, hit_index:
//   int) -> ReplayQueryHit
// Get one result of a recorded query from the most recently replayed frame.
// C: `b2ReplayQueryHit b2Replay_GetFrameQueryHit(const b2Replay *player, int
// queryIndex, int hitIndex)`
func m.replay_get_frame_query_hit(player, query_index, hit_index){}

// replay_get_body_count(player: ffi.Pointer) -> int
// Get the number of body slots tracked for the outliner. This is the
// creation-order span and includes holes for destroyed bodies, so it only grows
// as the replay advances.
// C: `int b2Replay_GetBodyCount(const b2Replay *player)`
func m.replay_get_body_count(player){}

// replay_get_body_id(player: ffi.Pointer, index: int) -> Body
// Get a tracked body by creation ordinal. Returns b2_nullBodyId for a destroyed
// slot, an ordinal not yet reached at the current frame, or an out-of-range
// index. Validate with b2Body_IsValid.
// C: `b2BodyId b2Replay_GetBodyId(const b2Replay *player, int index)`
func m.replay_get_body_id(player, index){}

// ------------------------------------------------------------ World

// A world: everything happens in one. Every world_* function of Box2D is
// a method or property (world:step(dt, sub_steps), world.gravity = g,
// world:cast_ray_closest(origin, translation)); bodies and joints are
// made through it.
// type World
// [valid]: bool (read-only)
// [bounds]: AABB (read-only)
// [body_events]: BodyEvents (read-only)
// [sensor_events]: SensorEvents (read-only)
// [contact_events]: ContactEvents (read-only)
// [joint_events]: JointEvents (read-only)
// [sleeping_enabled]: bool
// [continuous_enabled]: bool
// [restitution_threshold]: float
// [restitution_iterations]: int
// [restitution_propagation_enabled]: bool
// [hit_event_threshold]: float
// [gravity]: Vec2
// [contact_recycle_distance]: float
// [max_linear_speed]: float
// [warm_starting_enabled]: bool
// [awake_body_count]: int (read-only)
// [profile]: Profile (read-only)
// [counters]: Counters (read-only)
// [max_capacity]: Capacity (read-only)
// [user_data]: ffi.Pointer
// [friction_callback]: function (write-only)
// [restitution_callback]: function (write-only)
// [worker_count]: int
// [state_hash]: int (read-only)
local world_methods = {}

// destroy()
// Frees the world with every body, shape and joint in it.
func world_methods.destroy(self){}

// create_body(def?: BodyDef) -> Body
// A body from a def laid over Box2D's defaults: {type: "dynamic",
// position: {0, 4}, linear_velocity: {1, 0}} (static, at the origin, when
// left out); type is "static", "kinematic" or "dynamic", or Box2D's
// b2.dynamic_body and the like.
func world_methods.create_body(self, def){}

// create_distance_joint(def: DistanceJointDef) -> Joint
// A joint keeping two points a distance apart (length, enable_spring,
// hertz, damping_ratio, enable_limit, min_length, max_length,
// enable_motor, ...): the def's own fields with [JointBase].
func world_methods.create_distance_joint(self, def){}

// create_filter_joint(def: FilterJointDef) -> Joint
// A joint that only keeps two bodies from colliding.
func world_methods.create_filter_joint(self, def){}

// create_motor_joint(def: MotorJointDef) -> Joint
// A joint driving a body toward a relative position and angle
// (linear_velocity, angular_velocity, max_velocity_force, ...).
func world_methods.create_motor_joint(self, def){}

// create_mover_joint(def: MoverJointDef) -> Joint
// A joint moving a body at a velocity (linear_velocity,
// max_velocity_force).
func world_methods.create_mover_joint(self, def){}

// create_pogo_joint(def: PogoJointDef) -> Joint
// A spring along a body's axis (hertz, damping_ratio).
func world_methods.create_pogo_joint(self, def){}

// create_prismatic_joint(def: PrismaticJointDef) -> Joint
// A slider along an axis (enable_spring, hertz, enable_limit,
// lower_translation, upper_translation, enable_motor, max_motor_force,
// motor_speed, ...).
func world_methods.create_prismatic_joint(self, def){}

// create_revolute_joint(def: RevoluteJointDef) -> Joint
// A hinge (enable_spring, hertz, enable_limit, lower_angle, upper_angle,
// enable_motor, max_motor_torque, motor_speed, ...).
func world_methods.create_revolute_joint(self, def){}

// create_weld_joint(def: WeldJointDef) -> Joint
// A rigid (or springy: linear_hertz, angular_hertz, ...) weld.
func world_methods.create_weld_joint(self, def){}

// create_wheel_joint(def: WheelJointDef) -> Joint
// A wheel on a suspension (enable_spring, hertz, damping_ratio,
// enable_limit, enable_motor, max_motor_torque, motor_speed, ...).
func world_methods.create_wheel_joint(self, def){}

// get_body(key: int) -> Body?
// The body with a key ([Body.key]), while it is in the world.
func world_methods.get_body(self, key){}

// get_shape(key: int) -> Shape?
// The shape with a key ([Shape.key]).
func world_methods.get_shape(self, key){}

// contact_events() -> {begin_events: {ContactTouchEvent},
//   end_events: {ContactTouchEvent}, hit_events: {ContactHitEvent}}
// The contact events of the last step, as lists. A shape reports them when
// its def has enable_contact_events (the default) and, for hits,
// enable_hit_events.
func world_methods.contact_events(self){}

// sensor_events() -> {begin_events: {{sensor_shape: Shape,
//   visitor_shape: Shape}}, end_events: {{sensor_shape: Shape,
//   visitor_shape: Shape}}}
// The sensor events of the last step, as lists.
func world_methods.sensor_events(self){}

// body_events() -> {move_events: {{body: Body, transform: Transform,
//   fell_asleep: bool}}}
// The bodies that moved in the last step, as a list.
func world_methods.body_events(self){}

// joint_events() -> {joint_events: {{joint: Joint}}}
// The joint events of the last step (joints past their force or torque
// threshold), as a list.
func world_methods.joint_events(self){}

// step(time_step: float, sub_step_count: int)
// Simulate a world for one time step. This performs collision detection,
// integration, and constraint solution.
// C: `void b2World_Step(b2WorldId worldId, float timeStep, int subStepCount)`
// [world_id]: The world to simulate
// [time_step]: The amount of time to simulate, this should be a fixed number.
//   Usually 1/60.
// [sub_step_count]: The number of sub-steps, increasing the sub-step count can
//   increase accuracy. Usually 4.
func world_methods.step(self, time_step, sub_step_count){}

// draw(draw?: ffi.Pointer)
// Call this to draw shapes and other debug draw data
// C: `void b2World_Draw(b2WorldId worldId, b2DebugDraw *draw)`
func world_methods.draw(self, draw){}

// overlap_aabb(origin: Vec2, aabb: AABB, filter?: QueryFilter, fcn: function,
//   context: ffi.Pointer) -> TreeStats
// Overlap test for all shapes that *potentially* overlap the provided AABB. The
// AABB is relative to the origin, which keeps the test precise far from the
// world origin in large world mode. Near the origin pass b2Pos_zero and a world
// AABB.
// C: `b2TreeStats b2World_OverlapAABB(b2WorldId worldId, b2Vec2 origin, b2AABB
// aabb, b2QueryFilter filter, function *fcn, void *context)`
func world_methods.overlap_aabb(self, origin, aabb, filter, fcn, context){}

// overlap_shape(origin: Vec2, proxy: ShapeProxy, filter?: QueryFilter, fcn:
//   function, context: ffi.Pointer) -> TreeStats
// Overlap test for all shapes that overlap the provided shape proxy. The proxy
// points are relative to the origin. Near the origin pass b2Pos_zero and world
// points.
// C: `b2TreeStats b2World_OverlapShape(b2WorldId worldId, b2Vec2 origin, const
// b2ShapeProxy *proxy, b2QueryFilter filter, function *fcn, void *context)`
func world_methods.overlap_shape(self, origin, proxy, filter, fcn, context){}

// cast_ray(origin: Vec2, translation: Vec2, filter?: QueryFilter, fcn:
//   function, context: ffi.Pointer) -> TreeStats
// Cast a ray into the world to collect shapes in the path of the ray. Your
// callback function controls whether you get the closest point, any point, or
// n-points. Note: The callback function may receive shapes in any order Returns
// traversal performance counters
// C: `b2TreeStats b2World_CastRay(b2WorldId worldId, b2Vec2 origin, b2Vec2
// translation, b2QueryFilter filter, function *fcn, void *context)`
// [world_id]: The world to cast the ray against
// [origin]: The start point of the ray
// [translation]: The translation of the ray from the start point to the end
//   point
// [filter]: Contains bit flags to filter unwanted shapes from the results
// [fcn]: A user implemented callback function
// [context]: A user context that is passed along to the callback function
func world_methods.cast_ray(self, origin, translation, filter, fcn, context){}

// cast_ray_closest(origin: Vec2, translation: Vec2, filter?: QueryFilter) ->
//   RayResult
// Cast a ray into the world to collect the closest hit. This is a convenience
// function. Ignores initial overlap. This is less general than
// b2World_CastRay() and does not allow for custom filtering.
// C: `b2RayResult b2World_CastRayClosest(b2WorldId worldId, b2Vec2 origin,
// b2Vec2 translation, b2QueryFilter filter)`
func world_methods.cast_ray_closest(self, origin, translation, filter){}

// cast_shape(origin: Vec2, proxy: ShapeProxy, translation: Vec2, filter?:
//   QueryFilter, fcn: function, context: ffi.Pointer) -> TreeStats
// Cast a shape through the world. Similar to a ray cast except that a shape is
// cast instead of a point. The proxy points are relative to the origin.
// Callback points are world positions. b2World_CastRay
// C: `b2TreeStats b2World_CastShape(b2WorldId worldId, b2Vec2 origin, const
// b2ShapeProxy *proxy, b2Vec2 translation, b2QueryFilter filter, function *fcn,
// void *context)`
func world_methods.cast_shape(self, origin, proxy, translation, filter, fcn, context){}

// cast_mover(origin: Vec2, mover: Capsule, translation: Vec2, filter?:
//   QueryFilter) -> float
// Cast a capsule mover through the world. This is a special shape cast that
// handles sliding along other shapes while reducing clipping. The mover capsule
// is relative to the origin. Near the origin pass b2Pos_zero and a world
// capsule. Returns the translation fraction at the first hit.
// C: `float b2World_CastMover(b2WorldId worldId, b2Vec2 origin, const b2Capsule
// *mover, b2Vec2 translation, b2QueryFilter filter)`
func world_methods.cast_mover(self, origin, mover, translation, filter){}

// collide_mover(origin: Vec2, mover: Capsule, filter?: QueryFilter, fcn:
//   function, context: ffi.Pointer)
// Collide a capsule mover with the world, gathering collision planes that can
// be fed to b2SolvePlanes. Useful for kinematic character movement. The mover
// capsule and the resulting planes are relative to the origin.
// C: `void b2World_CollideMover(b2WorldId worldId, b2Vec2 origin, const
// b2Capsule *mover, b2QueryFilter filter, function *fcn, void *context)`
func world_methods.collide_mover(self, origin, mover, filter, fcn, context){}

// set_custom_filter_callback(fcn: function, context: ffi.Pointer)
// Register the custom filter callback. This is optional.
// C: `void b2World_SetCustomFilterCallback(b2WorldId worldId, function *fcn,
// void *context)`
func world_methods.set_custom_filter_callback(self, fcn, context){}

// set_pre_solve_callback(pre_solve_fcn: function, pre_continuous_fcn: function,
//   context: ffi.Pointer)
// Register the pre-solve and pre-continuous callbacks. This is optional.
// C: `void b2World_SetPreSolveCallback(b2WorldId worldId, function
// *preSolveFcn, function *preContinuousFcn, void *context)`
func world_methods.set_pre_solve_callback(self, pre_solve_fcn, pre_continuous_fcn, context){}

// explode(explosion_def?: ExplosionDef)
// Apply a radial explosion
// C: `void b2World_Explode(b2WorldId worldId, const b2ExplosionDef
// *explosionDef)`
// [world_id]: The world id
// [explosion_def]: The explosion definition
func world_methods.explode(self, explosion_def){}

// set_contact_tuning(hertz: float, damping_ratio: float, push_speed: float)
// Adjust contact tuning parameters Note: Advanced feature
// C: `void b2World_SetContactTuning(b2WorldId worldId, float hertz, float
// dampingRatio, float pushSpeed)`
// [world_id]: The world id
// [hertz]: The contact stiffness (cycles per second)
// [damping_ratio]: The contact bounciness with 1 being critical damping
//   (non-dimensional)
// [push_speed]: The maximum contact constraint push out speed (meters per
//   second)
func world_methods.set_contact_tuning(self, hertz, damping_ratio, push_speed){}

// get_contact_tuning(hertz: ffi.Pointer, damping_ratio: ffi.Pointer,
//   push_speed: ffi.Pointer)
// Get the contact tuning.
// C: `void b2World_GetContactTuning(b2WorldId worldId, float *hertz, float
// *dampingRatio, float *pushSpeed)`
func world_methods.get_contact_tuning(self, hertz, damping_ratio, push_speed){}

// enable_sse2_fallback(flag: bool)
// Force SSE2 to be used even when AVX2 is available. This is for testing.
// C: `void b2World_EnableSSE2Fallback(b2WorldId worldId, bool flag)`
func world_methods.enable_sse2_fallback(self, flag){}

// dump_memory_stats()
// Dump memory stats to box2d_memory.txt
// C: `void b2World_DumpMemoryStats(b2WorldId worldId)`
func world_methods.dump_memory_stats(self){}

// rebuild_static_tree()
// This is for internal testing
// C: `void b2World_RebuildStaticTree(b2WorldId worldId)`
func world_methods.rebuild_static_tree(self){}

// start_recording(recording: ffi.Pointer)
// Begin recording the world into recording. Serializes a snapshot of the
// current world as the seed, then logs every mutating call. Call at a step
// boundary, before or after creating bodies. Start before the first step to
// capture the whole session. No effect if already recording or if the world is
// locked.
// C: `void b2World_StartRecording(b2WorldId worldId, b2Recording *recording)`
// [world_id]: The world to record
// [recording]: A recording buffer from b2CreateRecording
func world_methods.start_recording(self, recording){}

// stop_recording()
// Stop recording. The recording buffer keeps its bytes. Save and destroy it
// yourself.
// C: `void b2World_StopRecording(b2WorldId worldId)`
// [world_id]: The world being recorded
func world_methods.stop_recording(self){}

// get_snapshot(image: ffi.Pointer, capacity: int) -> int
// Write a snapshot of the world's simulation state into a caller-owned buffer.
// Call once with image == NULL to get the required size, then again with a
// buffer of at least that size. Must be called at a step boundary. Returns The
// number of bytes the snapshot needs. If it exceeds capacity nothing is
// written. Returns 0 if the world is mid-step.
// C: `int b2World_GetSnapshot(b2WorldId worldId, uint8_t *image, int capacity)`
// [world_id]: The world to snapshot
// [image]: Destination buffer, or NULL to query the size
// [capacity]: Size of image in bytes, ignored when querying
func world_methods.get_snapshot(self, image, capacity){}

// restore_from_snapshot(image: ffi.Pointer, size: int) -> bool
// Restore a world's simulation state from a snapshot image. The b2WorldId and
// ids held from this same world stay valid for objects that existed at the
// snapshot instant. Callbacks and threading configuration are preserved. User
// data on shapes, bodies, and joints is nulled. Returns true on success. On a
// rejected image (bad magic, version, or layout) the world is left unchanged. A
// corrupt payload detected after the rebuild begins returns false and leaves
// the world unusable, so the caller must destroy it.
// C: `bool b2World_RestoreFromSnapshot(b2WorldId worldId, const uint8_t *image,
// int size)`
// [world_id]: The world to restore into
// [image]: A snapshot image produced by b2World_GetSnapshot
// [size]: Size of image in bytes
func world_methods.restore_from_snapshot(self, image, size){}

// ------------------------------------------------------------ Body

// A rigid body: every body_* function of Box2D is a method or property
// (body.position, body.linear_velocity = v, body:apply_force(f, point,
// wake)); shapes and chains are made on it.
// type Body
// [world]: the world it is in
// [key]: an int, the same for the same body: key tables by it
// [position]: Vec2: assigning moves the body (b2Body_SetTransform)
// [rotation]: Rot: assigning turns the body
// [valid]: bool (read-only)
// [type]: int
// [name]: string
// [user_data]: ffi.Pointer
// [transform]: Transform (read-only)
// [linear_velocity]: Vec2
// [angular_velocity]: float
// [mass]: float (read-only)
// [rotational_inertia]: float (read-only)
// [local_center]: Vec2 (read-only)
// [world_center]: Vec2 (read-only)
// [mass_data]: MassData
// [linear_damping]: float
// [angular_damping]: float
// [gravity_scale]: float
// [awake]: bool
// [sleeping_enabled]: bool
// [sleep_threshold]: float
// [safety_factor]: float
// [enabled]: bool
// [motion_locks]: MotionLocks
// [bullet]: bool
// [contact_recycling_enabled]: bool
// [shape_count]: int (read-only)
// [joint_count]: int (read-only)
// [contact_capacity]: int (read-only)
// [min_extent]: float (read-only)
// [max_extent]: float (read-only)
// [max_extent_from_origin]: float (read-only)
local body_methods = {}

// destroy()
// Takes the body, its shapes and its joints out of the world.
func body_methods.destroy(self){}

// create_circle_shape(def?: ShapeDef, circle: Circle) -> Shape
// A circle ({center, radius}) on the body, with a def laid over Box2D's
// defaults ({density: 1, material: {friction: 0.6}}).
func body_methods.create_circle_shape(self, def, circle){}

// create_capsule_shape(def?: ShapeDef, capsule: Capsule) -> Shape
// A capsule ({center1, center2, radius}) on the body.
func body_methods.create_capsule_shape(self, def, capsule){}

// create_polygon_shape(def?: ShapeDef, polygon: Polygon) -> Shape
// A convex polygon ([make_box], [make_polygon], ...) on the body.
func body_methods.create_polygon_shape(self, def, polygon){}

// create_segment_shape(def?: ShapeDef, segment: Segment) -> Shape
// A line segment ({point1, point2}) on the body.
func body_methods.create_segment_shape(self, def, segment){}

// create_chain_segment_shape(def?: ShapeDef, segment: ChainSegment) -> Shape
// One smooth segment of a chain, on its own.
func body_methods.create_chain_segment_shape(self, def, segment){}

// create_chain(def: ChainDef) -> Chain
// A chain of smooth segments ({points: {Vec2}, count, is_loop, ...}) on
// the body.
func body_methods.create_chain(self, def){}

// shapes() -> {Shape}
// The body's shapes.
func body_methods.shapes(self){}

// joints() -> {Joint}
// The joints attached to the body.
func body_methods.joints(self){}

// contact_data() -> {ContactData}
// The body's touching contacts, each with shape_a, shape_b and manifold.
func body_methods.contact_data(self){}

// set_transform(position: Vec2, rotation: Rot)
// Set the world transform of a body. This acts as a teleport and is fairly
// expensive. Note: Generally you should create a body with the intended
// transform. b2BodyDef::position and b2BodyDef::rotation
// C: `void b2Body_SetTransform(b2BodyId bodyId, b2Vec2 position, b2Rot
// rotation)`
func body_methods.set_transform(self, position, rotation){}

// get_local_point(world_point: Vec2) -> Vec2
// Get a local point on a body given a world point
// C: `b2Vec2 b2Body_GetLocalPoint(b2BodyId bodyId, b2Vec2 worldPoint)`
func body_methods.get_local_point(self, world_point){}

// get_world_point(local_point: Vec2) -> Vec2
// Get a world point on a body given a local point
// C: `b2Vec2 b2Body_GetWorldPoint(b2BodyId bodyId, b2Vec2 localPoint)`
func body_methods.get_world_point(self, local_point){}

// get_local_vector(world_vector: Vec2) -> Vec2
// Get a local vector on a body given a world vector
// C: `b2Vec2 b2Body_GetLocalVector(b2BodyId bodyId, b2Vec2 worldVector)`
func body_methods.get_local_vector(self, world_vector){}

// get_world_vector(local_vector: Vec2) -> Vec2
// Get a world vector on a body given a local vector
// C: `b2Vec2 b2Body_GetWorldVector(b2BodyId bodyId, b2Vec2 localVector)`
func body_methods.get_world_vector(self, local_vector){}

// set_target_transform(target: Transform, time_step: float, wake: bool)
// Set the velocity to reach the given transform after a given time step. The
// result will be close but may not be exact. This is meant for kinematic
// bodies. The target is not applied if the velocity would be below the sleep
// threshold and the body is currently asleep.
// C: `void b2Body_SetTargetTransform(b2BodyId bodyId, b2Transform target, float
// timeStep, bool wake)`
// [body_id]: The body id
// [target]: The target transform for the body
// [time_step]: The time step of the next call to b2World_Step
// [wake]: Option to wake the body or not
func body_methods.set_target_transform(self, target, time_step, wake){}

// get_local_point_velocity(local_point: Vec2) -> Vec2
// Get the linear velocity of a local point attached to a body. Usually in
// meters per second.
// C: `b2Vec2 b2Body_GetLocalPointVelocity(b2BodyId bodyId, b2Vec2 localPoint)`
func body_methods.get_local_point_velocity(self, local_point){}

// get_world_point_velocity(world_point: Vec2) -> Vec2
// Get the linear velocity of a world point attached to a body. Usually in
// meters per second.
// C: `b2Vec2 b2Body_GetWorldPointVelocity(b2BodyId bodyId, b2Vec2 worldPoint)`
func body_methods.get_world_point_velocity(self, world_point){}

// apply_force(force: Vec2, point: Vec2, wake: bool)
// Apply a force at a world point. If the force is not applied at the center of
// mass, it will generate a torque and affect the angular velocity. This
// optionally wakes up the body. The force is ignored if the body is not awake.
// C: `void b2Body_ApplyForce(b2BodyId bodyId, b2Vec2 force, b2Vec2 point, bool
// wake)`
// [body_id]: The body id
// [force]: The world force vector, usually in newtons (N)
// [point]: The world position of the point of application
// [wake]: Option to wake up the body
func body_methods.apply_force(self, force, point, wake){}

// apply_force_to_center(force: Vec2, wake: bool)
// Apply a force to the center of mass. This optionally wakes up the body. The
// force is ignored if the body is not awake.
// C: `void b2Body_ApplyForceToCenter(b2BodyId bodyId, b2Vec2 force, bool wake)`
// [body_id]: The body id
// [force]: the world force vector, usually in newtons (N).
// [wake]: also wake up the body
func body_methods.apply_force_to_center(self, force, wake){}

// apply_torque(torque: float, wake: bool)
// Apply a torque. This affects the angular velocity without affecting the
// linear velocity. This optionally wakes the body. The torque is ignored if the
// body is not awake.
// C: `void b2Body_ApplyTorque(b2BodyId bodyId, float torque, bool wake)`
// [body_id]: The body id
// [torque]: about the z-axis (out of the screen), usually in N*m.
// [wake]: also wake up the body
func body_methods.apply_torque(self, torque, wake){}

// clear_forces()
// Clear the force and torque on this body. Forces and torques are automatically
// cleared after each world step. So this only needs to be called if the
// application wants to remove the effect of previous calls to apply forces and
// torques before the world step is called.
// C: `void b2Body_ClearForces(b2BodyId bodyId)`
// [body_id]: The body id
func body_methods.clear_forces(self){}

// apply_linear_impulse(impulse: Vec2, point: Vec2, wake: bool)
// Apply an impulse at a point. This immediately modifies the velocity. It also
// modifies the angular velocity if the point of application is not at the
// center of mass. This optionally wakes the body. The impulse is ignored if the
// body is not awake. Warning: This should be used for one-shot impulses. If you
// need a steady force, use a force instead, which will work better with the
// sub-stepping solver.
// C: `void b2Body_ApplyLinearImpulse(b2BodyId bodyId, b2Vec2 impulse, b2Vec2
// point, bool wake)`
// [body_id]: The body id
// [impulse]: the world impulse vector, usually in N*s or kg*m/s.
// [point]: the world position of the point of application.
// [wake]: also wake up the body
func body_methods.apply_linear_impulse(self, impulse, point, wake){}

// apply_linear_impulse_to_center(impulse: Vec2, wake: bool)
// Apply an impulse to the center of mass. This immediately modifies the
// velocity. The impulse is ignored if the body is not awake. This optionally
// wakes the body. Warning: This should be used for one-shot impulses. If you
// need a steady force, use a force instead, which will work better with the
// sub-stepping solver.
// C: `void b2Body_ApplyLinearImpulseToCenter(b2BodyId bodyId, b2Vec2 impulse,
// bool wake)`
// [body_id]: The body id
// [impulse]: the world impulse vector, usually in N*s or kg*m/s.
// [wake]: also wake up the body
func body_methods.apply_linear_impulse_to_center(self, impulse, wake){}

// apply_angular_impulse(impulse: float, wake: bool)
// Apply an angular impulse. The impulse is ignored if the body is not awake.
// This optionally wakes the body. Warning: This should be used for one-shot
// impulses. If you need a steady torque, use a torque instead, which will work
// better with the sub-stepping solver.
// C: `void b2Body_ApplyAngularImpulse(b2BodyId bodyId, float impulse, bool
// wake)`
// [body_id]: The body id
// [impulse]: the angular impulse, usually in units of kg*m*m/s
// [wake]: also wake up the body
func body_methods.apply_angular_impulse(self, impulse, wake){}

// update_mass_from_shapes()
// This updates the mass properties to the sum of the mass properties of the
// shapes. This normally does not need to be called unless you called
// b2Body_SetMassData to override the mass and you later want to reset the mass.
// You may also use this when automatic mass computation has been disabled. You
// should call this regardless of body type. Note that sensor shapes may have
// mass.
// C: `void b2Body_UpdateMassFromShapes(b2BodyId bodyId)`
func body_methods.update_mass_from_shapes(self){}

// wake_touching()
// Wake bodies touching this body. Works for static bodies.
// C: `void b2Body_WakeTouching(b2BodyId bodyId)`
func body_methods.wake_touching(self){}

// enable_contact_events(flag: bool)
// Enable/disable contact events on all shapes. b2ShapeDef::enableContactEvents
// Warning: changing this at runtime may cause mismatched begin/end touch events
// C: `void b2Body_EnableContactEvents(b2BodyId bodyId, bool flag)`
func body_methods.enable_contact_events(self, flag){}

// enable_hit_events(flag: bool)
// Enable/disable hit events on all shapes b2ShapeDef::enableHitEvents
// C: `void b2Body_EnableHitEvents(b2BodyId bodyId, bool flag)`
func body_methods.enable_hit_events(self, flag){}

// get_shapes(shape_array: ffi.Pointer, capacity: int) -> int
// Get the shape ids for all shapes on this body, up to the provided capacity.
// Returns the number of shape ids stored in the user array
// C: `int b2Body_GetShapes(b2BodyId bodyId, b2ShapeId *shapeArray, int
// capacity)`
func body_methods.get_shapes(self, shape_array, capacity){}

// get_joints(joint_array: ffi.Pointer, capacity: int) -> int
// Get the joint ids for all joints on this body, up to the provided capacity
// Returns the number of joint ids stored in the user array
// C: `int b2Body_GetJoints(b2BodyId bodyId, b2JointId *jointArray, int
// capacity)`
func body_methods.get_joints(self, joint_array, capacity){}

// get_contact_data(contact_data: ffi.Pointer, capacity: int) -> int
// Get the touching contact data for a body. Note: Box2D uses speculative
// collision so some contact points may be separated. Returns the number of
// elements filled in the provided array Warning: do not ignore the return
// value, it specifies the valid number of elements
// C: `int b2Body_GetContactData(b2BodyId bodyId, b2ContactData *contactData,
// int capacity)`
func body_methods.get_contact_data(self, contact_data, capacity){}

// compute_bounds() -> AABB
// Get the current world AABB that contains all the attached shapes. Note that
// this may not encompass the body origin. If there are no shapes attached then
// the returned AABB is empty and centered on the body origin.
// C: `b2AABB b2Body_ComputeBounds(b2BodyId bodyId)`
func body_methods.compute_bounds(self){}

// ------------------------------------------------------------ Shape

// A shape on a body: every shape_* function is a method or property
// (shape.friction, shape:test_point(p), shape.aabb).
// type Shape
// [body]: the body it is on
// [key]: an int, the same for the same shape
// [valid]: bool (read-only)
// [type]: int (read-only)
// [world]: World (read-only)
// [sensor]: bool (read-only)
// [user_data]: ffi.Pointer
// [density]: float (read-only)
// [friction]: float
// [restitution]: float
// [user_material]: int
// [surface_material]: SurfaceMaterial
// [filter]: Filter
// [circle]: Circle
// [segment]: Segment
// [chain_segment]: ChainSegment
// [capsule]: Capsule
// [polygon]: Polygon
// [parent_chain]: Chain (read-only)
// [contact_capacity]: int (read-only)
// [sensor_capacity]: int (read-only)
// [bounds]: AABB (read-only)
local shape_methods = {}

// destroy(update_body_mass?: bool)
// Takes the shape off its body (and updates the body's mass, unless
// told not to).
func shape_methods.destroy(self, update_body_mass){}

// contact_data() -> {ContactData}
// The shape's touching contacts.
func shape_methods.contact_data(self){}

// sensor_data() -> {Shape}
// The shapes a sensor shape overlaps.
func shape_methods.sensor_data(self){}

// set_density(density: float, update_body_mass: bool)
// Set the mass density of a shape, usually in kg/m^2. This will optionally
// update the mass properties on the parent body. b2ShapeDef::density,
// b2Body_UpdateMassFromShapes
// C: `void b2Shape_SetDensity(b2ShapeId shapeId, float density, bool
// updateBodyMass)`
func shape_methods.set_density(self, density, update_body_mass){}

// enable_sensor_events(flag: bool)
// Enable sensor events for this shape. b2ShapeDef::enableSensorEvents
// C: `void b2Shape_EnableSensorEvents(b2ShapeId shapeId, bool flag)`
func shape_methods.enable_sensor_events(self, flag){}

// are_sensor_events_enabled() -> bool
// Returns true if sensor events are enabled.
// C: `bool b2Shape_AreSensorEventsEnabled(b2ShapeId shapeId)`
func shape_methods.are_sensor_events_enabled(self){}

// enable_contact_events(flag: bool)
// Enable contact events for this shape. Only applies to kinematic and dynamic
// bodies. Ignored for sensors. b2ShapeDef::enableContactEvents Warning:
// changing this at run-time may lead to lost begin/end events
// C: `void b2Shape_EnableContactEvents(b2ShapeId shapeId, bool flag)`
func shape_methods.enable_contact_events(self, flag){}

// are_contact_events_enabled() -> bool
// Returns true if contact events are enabled
// C: `bool b2Shape_AreContactEventsEnabled(b2ShapeId shapeId)`
func shape_methods.are_contact_events_enabled(self){}

// enable_pre_solve_events(flag: bool)
// Enable pre-solve contact events for this shape. Only applies to dynamic
// bodies. These are expensive and must be carefully handled due to
// multithreading. Ignored for sensors. b2PreSolveCallbackFcn
// C: `void b2Shape_EnablePreSolveEvents(b2ShapeId shapeId, bool flag)`
func shape_methods.enable_pre_solve_events(self, flag){}

// are_pre_solve_events_enabled() -> bool
// Returns true if pre-solve events are enabled
// C: `bool b2Shape_ArePreSolveEventsEnabled(b2ShapeId shapeId)`
func shape_methods.are_pre_solve_events_enabled(self){}

// enable_hit_events(flag: bool)
// Enable contact hit events for this shape. Ignored for sensors.
// b2WorldDef::hitEventThreshold
// C: `void b2Shape_EnableHitEvents(b2ShapeId shapeId, bool flag)`
func shape_methods.enable_hit_events(self, flag){}

// are_hit_events_enabled() -> bool
// Returns true if hit events are enabled
// C: `bool b2Shape_AreHitEventsEnabled(b2ShapeId shapeId)`
func shape_methods.are_hit_events_enabled(self){}

// test_point(point: Vec2) -> bool
// Test a world point for overlap with a shape
// C: `bool b2Shape_TestPoint(b2ShapeId shapeId, b2Vec2 point)`
func shape_methods.test_point(self, point){}

// cast_ray(origin: Vec2, translation: Vec2) -> CastOutput
// Ray cast a single shape. The ray starts at the origin and extends by the
// translation. The output point is a world position.
// C: `b2CastOutput b2Shape_CastRay(b2ShapeId shapeId, b2Vec2 origin, b2Vec2
// translation)`
func shape_methods.cast_ray(self, origin, translation){}

// get_contact_data(contact_data: ffi.Pointer, capacity: int) -> int
// Get the touching contact data for a shape. The provided shapeId will be
// either shapeIdA or shapeIdB on the contact data. Note: Box2D uses speculative
// collision so some contact points may be separated. Returns the number of
// elements filled in the provided array Warning: do not ignore the return
// value, it specifies the valid number of elements
// C: `int b2Shape_GetContactData(b2ShapeId shapeId, b2ContactData *contactData,
// int capacity)`
func shape_methods.get_contact_data(self, contact_data, capacity){}

// get_sensor_data(visitor_ids: ffi.Pointer, capacity: int) -> int
// Get the overlap data for a sensor shape computed during the previous world
// step. Returns the number of elements filled in the provided array Warning: do
// not ignore the return value, it specifies the valid number of elements
// Warning: overlaps may contain destroyed shapes so use b2Shape_IsValid to
// confirm each overlap
// C: `int b2Shape_GetSensorData(b2ShapeId shapeId, b2ShapeId *visitorIds, int
// capacity)`
// [shape_id]: the id of a sensor shape
// [visitor_ids]: a user allocated array that is filled with the overlapping
//   shapes (visitors)
// [capacity]: the capacity of visitorIds
func shape_methods.get_sensor_data(self, visitor_ids, capacity){}

// compute_mass_data() -> MassData
// Compute the mass data for a shape
// C: `b2MassData b2Shape_ComputeMassData(b2ShapeId shapeId)`
func shape_methods.compute_mass_data(self){}

// get_closest_point(target: Vec2) -> Vec2
// Get the closest point on a shape to a target point. Target and result are
// world positions.
// C: `b2Vec2 b2Shape_GetClosestPoint(b2ShapeId shapeId, b2Vec2 target)`
func shape_methods.get_closest_point(self, target){}

// apply_wind(wind: Vec2, drag: float, lift: float, wake: bool)
// Apply a wind force to the body for this shape using the density of air. This
// considers the projected area of the shape in the wind direction. This also
// considers the relative velocity of the shape.
// C: `void b2Shape_ApplyWind(b2ShapeId shapeId, b2Vec2 wind, float drag, float
// lift, bool wake)`
// [shape_id]: the shape id
// [wind]: the wind velocity in world space
// [drag]: the drag coefficient, the force that opposes the relative velocity
// [lift]: the lift coefficient, the force that is perpendicular to the relative
//   velocity
// [wake]: should this wake the body
func shape_methods.apply_wind(self, wind, drag, lift, wake){}

// ------------------------------------------------------------ Chain

// A chain of segments on a body: every chain_* function is a method or
// property.
// type Chain
// [body]: the body it is on
// [world]: World (read-only)
// [segment_count]: int (read-only)
// [all_surface_materials]: SurfaceMaterial (write-only)
// [valid]: bool (read-only)
local chain_methods = {}

// destroy()
// Takes the chain off its body.
func chain_methods.destroy(self){}

// segments() -> {Shape}
// The segment shapes of the chain.
func chain_methods.segments(self){}

// get_segments(segment_array: ffi.Pointer, capacity: int) -> int
// Fill a user array with chain segment shape ids up to the specified capacity.
// Returns the actual number of segments returned.
// C: `int b2Chain_GetSegments(b2ChainId chainId, b2ShapeId *segmentArray, int
// capacity)`
func chain_methods.get_segments(self, segment_array, capacity){}

// set_surface_material(material?: SurfaceMaterial, segment_index: int)
// Set a chain material by segment index.
// C: `void b2Chain_SetSurfaceMaterial(b2ChainId chainId, const
// b2SurfaceMaterial *material, int segmentIndex)`
func chain_methods.set_surface_material(self, material, segment_index){}

// get_surface_material(segment_index: int) -> SurfaceMaterial
// Get a chain material by segment index.
// C: `b2SurfaceMaterial b2Chain_GetSurfaceMaterial(b2ChainId chainId, int
// segmentIndex)`
func chain_methods.get_surface_material(self, segment_index){}

// ------------------------------------------------------------ Joint

// A joint between two bodies: every joint_* function is a method or
// property, and so are those of its kind (revolute_joint_set_motor_speed
// is joint.motor_speed = s).
// type Joint
// [kind]: "distance", "filter", "motor", "mover", "pogo", "prismatic",
//   "revolute", "weld" or "wheel"
// [world]: the world it is in
// [valid]: bool (read-only)
// [type]: int (read-only)
// [body_a]: Body (read-only)
// [body_b]: Body (read-only)
// [local_frame_a]: Transform
// [local_frame_b]: Transform
// [collide_connected]: bool
// [user_data]: ffi.Pointer
// [constraint_force]: Vec2 (read-only)
// [constraint_torque]: float (read-only)
// [linear_separation]: float (read-only)
// [angular_separation]: float (read-only)
// [force_threshold]: float
// [torque_threshold]: float
// [rest_length]: float
// [spring_enabled]: bool
// [spring_hertz]: float
// [spring_damping_ratio]: float
// [spring_force]: float (read-only)
// [limit_enabled]: bool
// [lower_limit]: float (read-only)
// [upper_limit]: float (read-only)
// [current_length]: float (read-only)
// [motor_enabled]: bool
// [target_motor_speed]: float
// [max_motor_force]: float
// [current_motor_force]: float (read-only)
// [linear_velocity]: Vec2
// [angular_velocity]: float
// [max_velocity_force]: float
// [max_velocity_torque]: float
// [linear_hertz]: float
// [linear_damping_ratio]: float
// [angular_hertz]: float
// [angular_damping_ratio]: float
// [max_spring_force]: float
// [max_spring_torque]: float
// [current_speed]: float (read-only)
// [impulse]: float (read-only)
// [target_translation]: float
// [current_translation]: float (read-only)
// [target_angle]: float
// [max_motor_torque]: float
// [current_angle]: float (read-only)
// [current_motor_torque]: float (read-only)
local joint_methods = {}

// destroy()
// Takes the joint out of the world.
func joint_methods.destroy(self){}

// wake_bodies()
// Wake the bodies connected to this joint
// C: `void b2Joint_WakeBodies(b2JointId jointId)`
func joint_methods.wake_bodies(self){}

// set_constraint_tuning(hertz: float, damping_ratio: float)
// Set the joint constraint tuning. Advanced feature.
// C: `void b2Joint_SetConstraintTuning(b2JointId jointId, float hertz, float
// dampingRatio)`
// [joint_id]: the joint
// [hertz]: the stiffness in Hertz (cycles per second)
// [damping_ratio]: the non-dimensional damping ratio (one for critical damping)
func joint_methods.set_constraint_tuning(self, hertz, damping_ratio){}

// get_constraint_tuning(hertz: ffi.Pointer, damping_ratio: ffi.Pointer)
// Get the joint constraint tuning. Advanced feature.
// C: `void b2Joint_GetConstraintTuning(b2JointId jointId, float *hertz, float
// *dampingRatio)`
func joint_methods.get_constraint_tuning(self, hertz, damping_ratio){}

// set_spring_force_range(lower_force: float, upper_force: float)
// Set the force range for the spring.
// C: `void b2DistanceJoint_SetSpringForceRange(b2JointId jointId, float
// lowerForce, float upperForce)`
func joint_methods.set_spring_force_range(self, lower_force, upper_force){}

// get_spring_force_range(lower_force: ffi.Pointer, upper_force: ffi.Pointer)
// Get the force range for the spring.
// C: `void b2DistanceJoint_GetSpringForceRange(b2JointId jointId, float
// *lowerForce, float *upperForce)`
func joint_methods.get_spring_force_range(self, lower_force, upper_force){}

// set_limits(min_length: float, max_length: float)
// Set the minimum and maximum length parameters of a distance joint
// C: `void b2DistanceJoint_SetLimits(b2JointId jointId, float minLength, float
// maxLength)`
func joint_methods.set_limits(self, min_length, max_length){}

return m
