// as described in the GLTF 2.0 specification:
// https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
//   cubic_hermite(v1: Vector3, tangent1: Vector3, v2: Vector3, tangent2:
//      Vector3, amount: float) -> Vector3
//   C: Vector3 Vector3CubicHermite(Vector3 v1, Vector3 tangent1, Vector3 v2,
//      Vector3 tangent2, float amount)
func ns_vector3_fns.cubic_hermite(v1, tangent1, v2, tangent2, amount){ return {x: 0, y: 0, z: 0} }

// Calculate distance between two vectors
//   distance(v1: Vector3, v2: Vector3) -> float
//   C: float Vector3Distance(Vector3 v1, Vector3 v2)
func ns_vector3_fns.distance(v1, v2){}

// Calculate square distance between two vectors
//   distance_sqr(v1: Vector3, v2: Vector3) -> float
//   C: float Vector3DistanceSqr(Vector3 v1, Vector3 v2)
func ns_vector3_fns.distance_sqr(v1, v2){}

