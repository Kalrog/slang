// application_directory(self) -> string
// Get the directory of the running application (uses static string)
// C: GetApplicationDirectory
func rl_get.application_directory(self){}

// automation_event_base_frame(self, v: int)
// Set automation event internal base frame to start recording
// C: SetAutomationEventBaseFrame (write-only)
func rl_set.automation_event_base_frame(self, v){}

// automation_event_list(self, v: AutomationEventList (updated))
// Set automation event list to record to
// C: SetAutomationEventList (write-only)
func rl_set.automation_event_list(self, v){}

// Change working directory, return true on success
//   change_directory(dir: string) -> bool
//   C: bool ChangeDirectory(const char *dir)
func m.change_directory(dir){}

// Clamp float value
//   clamp(value: float, min: float, max: float) -> float
//   C: float Clamp(float value, float min, float max)
func m.clamp(value, min, max){}

// Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on
// failure
//   codepoint(text: string, codepoint_size: pointer) -> int
//   C: int GetCodepoint(const char *text, int *codepointSize)
func m.codepoint(text, codepoint_size){}

// Get total number of codepoints in a UTF-8 encoded string
//   codepoint_count(text: string) -> int
//   C: int GetCodepointCount(const char *text)
func m.codepoint_count(text){}

// Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on
// failure
//   codepoint_next(text: string, codepoint_size: pointer) -> int
//   C: int GetCodepointNext(const char *text, int *codepointSize)
func m.codepoint_next(text, codepoint_size){}

// Get previous codepoint in a UTF-8 encoded string, 0x3f('?') is returned on
// failure
//   codepoint_previous(text: string, codepoint_size: pointer) -> int
//   C: int GetCodepointPrevious(const char *text, int *codepointSize)
func m.codepoint_previous(text, codepoint_size){}

// Encode one codepoint into UTF-8 byte array (array length returned as
// parameter)
//   codepoint_to_utf8(codepoint: int, utf8_size: pointer) -> string
//   C: const char *CodepointToUTF8(int codepoint, int *utf8Size)
func m.codepoint_to_utf8(codepoint, utf8_size){}

// Compress data (DEFLATE algorithm), memory must be MemFree()
//   compress_data(data: string, comp_data_size: pointer) -> string
//   C: unsigned char *CompressData(const unsigned char *data, int dataSize, int
//      *compDataSize)
func m.compress_data(data, comp_data_size){}

// Compute CRC32 hash code
//   compute_crc32(data: string) -> int
//   C: unsigned int ComputeCRC32(unsigned char *data, int dataSize)
func m.compute_crc32(data){}

// Compute MD5 hash code, returns static int[4] (16 bytes)
//   compute_md5(data: string) -> pointer
//   C: unsigned int *ComputeMD5(unsigned char *data, int dataSize)
func m.compute_md5(data){}

// Compute SHA1 hash code, returns static int[5] (20 bytes)
//   compute_sha1(data: string) -> pointer
//   C: unsigned int *ComputeSHA1(unsigned char *data, int dataSize)
func m.compute_sha1(data){}

// config_flags(self, v: int)
