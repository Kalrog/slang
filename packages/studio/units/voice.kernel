// studio/units/voice: the voice the poly and drums units play: an
// oscillator (or a drum's own sound) by its wave, a state variable filter
// its envelope opens, a drive, a pan. One kernel renders every voice of a
// unit; what a voice plays is its row of NP parameters in vp, copied from
// the unit's parameters when its note starts.
use "studio/lib"

struct Voice {
  on: int32,
  stage: int32, // 0 attack, 1 decay and sustain, 2 release
  ctr: int32,
  held: int32, // 1: released, but the pedal holds it
  rnd: int64,
  note: double,
  vel: double,
  freq: double,
  target: double,
  env: double,
  amp: double, // a drum's loudness, falling from 1
  penv: double, // a drum's pitch envelope, falling from 1
  t: double, // seconds since the note
  phase: double,
  phase2: double,
  ic1: double,
  ic2: double,
  lp: double,
  g: double,
  k: double,
  pl: double,
  pr: double,
  ac: double,
  dc: double,
  rc: double,
  gl: double,
  pk: double,
  d1: double,
  d2: double,
  p3: double,
  p4: double,
  p5: double,
  p6: double,
  p7: double,
}

// a voice's parameters in vp
local NP = 16
local WAVE = 0
local SUSTAIN = 3
local CUTOFF = 5
local RES = 6
local ENV = 7
local GAIN = 8
local PAN = 9
local DETUNE = 10
local PW = 11
local FM = 13
local RATIO = 14
local DRIVE = 15

local func white(v: Voice): float {
  v.rnd = (v.rnd * 6364136223846793005 + 1442695040888963407) &
    9223372036854775807
  return float((v.rnd >> 20) & 1048575) / 524288.0 - 1.0
}

// frames start .. start + n - 1 of l and r; bend multiplies every pitch.
// Returns the voices still sounding.
func render(
  l: float[], r: float[], start: int, n: int, sr: double, voices: Voice[],
  vp: double[], bend: double
): int {
  local nv = len(voices)
  local inv = 1.0 / sr
  // the drums' filters, the same for every sample: the 808 snare's high
  // pass, its hats' (5 kHz), the clap's band pass and the cowbell's
  local snare_k = 1.0 - exp(-TAU * 900.0 * inv)
  local hat_k = 1.0 - exp(-TAU * 5000.0 * inv)
  local clap_f = 2.0 * sin(PI * 1100.0 * inv)
  local bell_f = 2.0 * sin(PI * 2200.0 * inv)
  for(local i = start; i < start + n; i += 1){
    l[i] = 0.0
    r[i] = 0.0
  }
  local sounding = 0
  for(local vi = 0; vi < nv; vi += 1){
    local v = voices[vi]
    if(v.on == 0){
      continue
    }
    local pb = vi * NP
    local wave = int(vp[pb + WAVE])
    local sustain = vp[pb + SUSTAIN]
    local det = vp[pb + DETUNE]
    local pw = vp[pb + PW]
    local drive = vp[pb + DRIVE]
    local level = v.vel * vp[pb + GAIN]
    local cut0 = vp[pb + CUTOFF]
    local cut1 = vp[pb + ENV]
    for(local i = start; i < start + n; i += 1){
      // the envelope
      if(wave < 6 or wave == 19){
        if(v.stage == 0){
          v.env += v.ac
          if(v.env >= 1.0){
            v.env = 1.0
            v.stage = 1
          }
        } else if(v.stage == 1){
          v.env += (sustain - v.env) * v.dc
        } else {
          v.env *= v.rc
          if(v.env < 0.0005){
            v.on = 0
            break
          }
        }
      } else {
        v.amp *= v.dc
        v.penv *= v.pk
        if(v.amp < 0.001){
          v.on = 0
          break
        }
        v.env = v.amp
      }
      v.t += inv
      v.freq += (v.target - v.freq) * v.gl
      local dt = v.freq * bend * inv
      local y = 0.0
      if(wave == 0){
        v.phase += dt
        v.phase -= floor(v.phase)
        y = 2.0 * v.phase - 1.0 - blep(v.phase, dt)
        if(det != 0.0){
          local dt2 = dt * exp2(det / 1200.0)
          v.phase2 += dt2
          v.phase2 -= floor(v.phase2)
          y = (y + 2.0 * v.phase2 - 1.0 - blep(v.phase2, dt2)) * 0.6
        }
      } else if(wave == 1){
        v.phase += dt
        v.phase -= floor(v.phase)
        local w = clamp(pw, 0.05, 0.95)
        y = select(v.phase < w, 1.0, -1.0)
        y += blep(v.phase, dt)
        local t2 = v.phase + 1.0 - w
        t2 -= floor(t2)
        y -= blep(t2, dt)
        if(det != 0.0){
          local dt2 = dt * exp2(det / 1200.0)
          v.phase2 += dt2
          v.phase2 -= floor(v.phase2)
          local y2 = select(v.phase2 < w, 1.0, -1.0) + blep(v.phase2, dt2)
          t2 = v.phase2 + 1.0 - w
          t2 -= floor(t2)
          y2 -= blep(t2, dt2)
          y = (y + y2) * 0.6
        }
      } else if(wave == 2){
        v.phase += dt
        v.phase -= floor(v.phase)
        y = 1.0 - 4.0 * abs(v.phase - 0.5)
      } else if(wave == 3){
        v.phase += dt
        v.phase -= floor(v.phase)
        y = sin(v.phase * TAU)
      } else if(wave == 4){
        y = white(v)
      } else if(wave == 5){
        v.phase += dt
        v.phase -= floor(v.phase)
        v.phase2 += dt * vp[pb + RATIO]
        v.phase2 -= floor(v.phase2)
        y = sin(v.phase * TAU + vp[pb + FM] * v.env * sin(v.phase2 * TAU))
      } else if(wave == 6){
        // kick: a sine dropping from eight times its pitch, with a click
        v.phase += dt * (1.0 + 7.0 * v.penv)
        v.phase -= floor(v.phase)
        y = sin(v.phase * TAU) + white(v) * v.penv * 0.3
      } else if(wave == 7){
        // snare: a short tone and a noise tail
        v.phase += dt
        v.phase -= floor(v.phase)
        local nz = white(v)
        v.lp += (nz - v.lp) * 0.2
        y = sin(v.phase * TAU) * v.penv * 0.8 + (nz - v.lp) * 0.7
      } else if(wave == 8 or wave == 9){
        // hats: noise above a one-pole
        local nz = white(v)
        v.lp += (nz - v.lp) * 0.35
        y = (nz - v.lp) * 0.8
      } else if(wave == 10){
        // clap: three bursts, then a tail
        local nz = white(v)
        v.lp += (nz - v.lp) * 0.15
        local e = 1.0
        if(v.t < 0.03){
          e = 1.0 - fract(v.t * 100.0)
          v.amp = 1.0
        }
        y = (nz - v.lp) * e * 0.9
      } else if(wave == 11){
        // tom: a sine dropping a little
        v.phase += dt * (1.0 + 1.5 * v.penv)
        v.phase -= floor(v.phase)
        y = sin(v.phase * TAU)
      } else if(wave == 12){
        // rim: a tick
        v.phase += dt
        v.phase -= floor(v.phase)
        y = sin(v.phase * TAU) * v.penv + white(v) * v.penv * 0.5
      } else if(wave == 13){
        // 808 kick: a sine whose pitch sweeps down from the hit, driven
        // hard while it is loud (the click and the punch)
        v.phase += dt * (1.0 + 3.5 * v.penv)
        v.phase -= floor(v.phase)
        y = tanh(sin(v.phase * TAU) * (1.0 + 3.0 * v.amp)) * 0.8
      } else if(wave == 14){
        // 808 snare: two resonators (the second 1.83 times the first)
        // decaying with the pitch envelope, and noise through a high pass
        v.phase += dt
        v.phase -= floor(v.phase)
        v.phase2 += dt * 1.83
        v.phase2 -= floor(v.phase2)
        local nz = white(v)
        v.d1 += (nz - v.d1) * snare_k
        y = (sin(v.phase * TAU) * 0.7 + sin(v.phase2 * TAU) * 0.4) * v.penv *
          0.8
        y += (nz - v.d1) * 0.9
      } else if(wave == 15 or wave == 16){
        // 808 hats: six square waves at the 808's frequencies (scaled by
        // the note, 830 Hz being as it was) through a high pass; the
        // closed and the open differ in their decay, and a closed hat
        // chokes an open one (the unit, at the note)
        local s = v.t * v.freq / 830.0
        local metal = select(fract(s * 205.3) < 0.5, 1.0, -1.0)
        metal += select(fract(s * 304.4) < 0.5, 1.0, -1.0)
        metal += select(fract(s * 369.6) < 0.5, 1.0, -1.0)
        metal += select(fract(s * 522.7) < 0.5, 1.0, -1.0)
        metal += select(fract(s * 540.0) < 0.5, 1.0, -1.0)
        metal += select(fract(s * 800.0) < 0.5, 1.0, -1.0)
        // the six summed (-6..6) through two one-poles at 5 kHz: what
        // is left are the edges, the metallic hiss; soft-clipped
        local hk = hat_k
        v.d1 += (metal - v.d1) * hk
        local h1 = metal - v.d1
        v.d2 += (h1 - v.d2) * hk
        y = tanh((h1 - v.d2) * 0.7) * 1.3
      } else if(wave == 17){
        // 808 clap: noise through a band pass, three bursts 9 ms apart,
        // then the tail
        local nz = white(v)
        local f = clap_f
        v.d1 += f * v.d2
        v.d2 += f * (nz - v.d1 - 0.8 * v.d2)
        local e = 1.0
        if(v.t < 0.027){
          e = exp(-fract(v.t * 111.1) * 2.6)
          v.amp = 1.0
        }
        y = v.d2 * e * 2.5
      } else if(wave == 19){
        // supersaw: seven saws, the middle one at the pitch, six spread
        // around it as the JP-8000 spread them, the outer ones DETUNE
        // cents off, mixed in at PW; band-limited each
        local spread = det
        if(spread == 0.0){
          spread = 18.0
        }
        local side = clamp(pw, 0.0, 1.0)
        v.phase += dt
        v.phase -= floor(v.phase)
        y = 2.0 * v.phase - 1.0 - blep(v.phase, dt)
        local d2 = dt * exp2(spread * -1.0239 / 1200.0)
        v.phase2 += d2
        v.phase2 -= floor(v.phase2)
        local s = 2.0 * v.phase2 - 1.0 - blep(v.phase2, d2)
        local d3 = dt * exp2(spread * -0.5852 / 1200.0)
        v.p3 += d3
        v.p3 -= floor(v.p3)
        s += 2.0 * v.p3 - 1.0 - blep(v.p3, d3)
        local d4 = dt * exp2(spread * -0.1817 / 1200.0)
        v.p4 += d4
        v.p4 -= floor(v.p4)
        s += 2.0 * v.p4 - 1.0 - blep(v.p4, d4)
        local d5 = dt * exp2(spread * 0.1853 / 1200.0)
        v.p5 += d5
        v.p5 -= floor(v.p5)
        s += 2.0 * v.p5 - 1.0 - blep(v.p5, d5)
        local d6 = dt * exp2(spread * 0.5785 / 1200.0)
        v.p6 += d6
        v.p6 -= floor(v.p6)
        s += 2.0 * v.p6 - 1.0 - blep(v.p6, d6)
        local d7 = dt * exp2(spread / 1200.0)
        v.p7 += d7
        v.p7 -= floor(v.p7)
        s += 2.0 * v.p7 - 1.0 - blep(v.p7, d7)
        y = (y + s * side) / (1.0 + 6.0 * side) * 2.2
      } else {
        // 808 cowbell: two square waves (587 and 845 Hz at its note)
        // through a band pass
        v.phase += dt
        v.phase -= floor(v.phase)
        v.phase2 += dt * 1.4395
        v.phase2 -= floor(v.phase2)
        local cb = (select(v.phase < 0.5, 1.0, -1.0) +
          select(v.phase2 < 0.5, 1.0, -1.0)) * 0.5
        local f = bell_f
        v.d1 += f * v.d2
        v.d2 += f * (cb - v.d1 - 0.6 * v.d2)
        y = v.d2 * 1.5
      }
      // the filter, its coefficients every eight samples
      local cut = cut0 + cut1 * v.env
      if((v.ctr & 7) == 0){
        local fc = clamp(
          20.0 * exp2(clamp(cut, 0.0, 1.0) * 10.0), 20.0, sr * 0.45
        )
        v.g = tan(PI * fc * inv)
        v.k = 2.0 - 1.96 * clamp(vp[pb + RES], 0.0, 1.0)
        local pan = clamp(vp[pb + PAN], -1.0, 1.0)
        v.pl = cos((pan + 1.0) * PI * 0.25)
        v.pr = sin((pan + 1.0) * PI * 0.25)
      }
      v.ctr += 1
      if(cut < 1.0){
        local g = v.g
        local a1 = 1.0 / (1.0 + g * (g + v.k))
        local a2 = g * a1
        local a3 = g * a2
        local v3 = y - v.ic2
        local v1 = a1 * v.ic1 + a2 * v3
        local v2 = v.ic2 + a2 * v.ic1 + a3 * v3
        v.ic1 = 2.0 * v1 - v.ic1
        v.ic2 = 2.0 * v2 - v.ic2
        y = v2
      }
      if(drive > 0.0){
        y = tanh(y * (1.0 + drive * 8.0)) / (1.0 + drive * 0.3)
      }
      y *= v.env * level
      l[i] += y * v.pl
      r[i] += y * v.pr
    }
    if(v.on != 0){
      sounding += 1
    }
  }
  return sounding
}
