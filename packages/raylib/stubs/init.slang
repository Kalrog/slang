//   C: RayCollision GetRayCollisionSphere(Ray ray, Vector3 center, float
//      radius)
func ns_collision_fns.ray_sphere(ray, center, radius){ return {hit: false, distance: 0, point: {x: 0, y: 0, z: 0}, normal: {x: 0, y: 0, z: 0}} }

