// render/flora_paint: a small painter for the foliage texture
// (render/flora.slang): strokes and leaves drawn into a picture of
// r, g, b, a bytes with soft edges. A pixel's alpha is how much of it
// foliage covers; its color is the foliage's even where nothing covers
// it, so that the texture's smaller copies do not darken at the edges.

// fill: every pixel of a w by h picture one color, covered by nothing
func fill(image: uint8[], w: int, h: int, r: float, g: float, b: float){
  for(local i = 0; i < w * h; i += 1){
    image[i * 4] = int(r)
    image[i * 4 + 1] = int(g)
    image[i * 4 + 2] = int(b)
    image[i * 4 + 3] = 0
  }
}

// one pixel under a color that covers it by c (0..1)
local func cover(image: uint8[], at: int, c: float, r: float, g: float, b: float){
  if(c > 0.004){
    local old = image[at + 3] / 255.0
    // over what is there: all of the new color where nothing was yet
    local k = c
    if(old < 0.02){
      k = 1.0
    }
    image[at] = int(mix(image[at], r, k))
    image[at + 1] = int(mix(image[at + 1], g, k))
    image[at + 2] = int(mix(image[at + 2], b, k))
    image[at + 3] = int(clamp(max(old, c) * 255.0, 0, 255))
  }
}

// stroke: a line from (x0, y0) to (x1, y1), thick pixels wide at its
// start and thin at its end
func stroke(image: uint8[], w: int, h: int, x0: float, y0: float, x1: float, y1: float,
  thick: float, thin: float, r: float, g: float, b: float){
  local reach = max(thick, thin) + 1.5
  local ax = int(clamp(floor(min(x0, x1) - reach), 0, w - 1))
  local bx = int(clamp(floor(max(x0, x1) + reach) + 1, 0, w - 1))
  local ay = int(clamp(floor(min(y0, y1) - reach), 0, h - 1))
  local by = int(clamp(floor(max(y0, y1) + reach) + 1, 0, h - 1))
  local ex = x1 - x0
  local ey = y1 - y0
  local l2 = max(ex * ex + ey * ey, 0.0001)
  for(local y = ay; y <= by; y += 1){
    for(local x = ax; x <= bx; x += 1){
      local px = x + 0.5 - x0
      local py = y + 0.5 - y0
      local t = clamp((px * ex + py * ey) / l2, 0, 1)
      local dx = px - ex * t
      local dy = py - ey * t
      local d = sqrt(dx * dx + dy * dy)
      local half = mix(thick, thin, t) * 0.5
      cover(image, (y * w + x) * 4, clamp(half + 0.6 - d, 0, 1), r, g, b)
    }
  }
}

// leaf: a leaf from its stalk at (x, y) along angle, long and wide in
// pixels: pointed at both ends, a lighter rib down its middle, darker
// toward its edge; lobes over 0 cut its edge into that many waves
func leaf(image: uint8[], w: int, h: int, x: float, y: float, angle: float, long: float,
  wide: float, lobes: float, r: float, g: float, b: float){
  local ca = cos(angle)
  local sa = sin(angle)
  local reach = long + 2.0
  local ax = int(clamp(floor(x - reach), 0, w - 1))
  local bx = int(clamp(floor(x + reach) + 1, 0, w - 1))
  local ay = int(clamp(floor(y - reach), 0, h - 1))
  local by = int(clamp(floor(y + reach) + 1, 0, h - 1))
  for(local py = ay; py <= by; py += 1){
    for(local px = ax; px <= bx; px += 1){
      local dx = px + 0.5 - x
      local dy = py + 0.5 - y
      // along the leaf (0 at the stalk, 1 at the tip) and across it
      local u = (dx * ca + dy * sa) / long
      local v = (-dx * sa + dy * ca) / (wide * 0.5)
      if(u > -0.02 and u < 1.02){
        // widest a little before the middle
        local shape = pow(clamp(sin(clamp(u, 0, 1) * PI), 0, 1), 0.8) * (1.12 - 0.3 * u)
        if(lobes > 0){
          shape *= 0.74 + 0.26 * abs(sin(u * PI * lobes))
        }
        local edge = (shape - abs(v)) * wide * 0.5
        local c = clamp(edge + 0.5, 0, 1)
        if(c > 0){
          local rib = clamp(1 - abs(v) * wide * 0.5 / 1.3, 0, 1) * 0.28
          local shade = 0.78 + 0.22 * clamp(edge / (wide * 0.3), 0, 1) + rib
          cover(image, (py * w + px) * 4, c, r * shade, g * shade, b * shade)
        }
      }
    }
  }
}

// mean: the mean color of what is covered in a square of the picture
// (from x0, y0, side pixels wide), as light (0..1, the bytes squared),
// into out[0..2]; out[3] gets the share of the square that is covered
func mean(image: uint8[], w: int, x0: int, y0: int, side: int, out: float[]){
  local r = 0.0
  local g = 0.0
  local b = 0.0
  local a = 0.0
  for(local y = y0; y < y0 + side; y += 1){
    for(local x = x0; x < x0 + side; x += 1){
      local at = (y * w + x) * 4
      local c = image[at + 3] / 255.0
      r += c * (image[at] / 255.0) * (image[at] / 255.0)
      g += c * (image[at + 1] / 255.0) * (image[at + 1] / 255.0)
      b += c * (image[at + 2] / 255.0) * (image[at + 2] / 255.0)
      a += c
    }
  }
  out[0] = r / max(a, 1.0)
  out[1] = g / max(a, 1.0)
  out[2] = b / max(a, 1.0)
  out[3] = a / (side * side)
}
