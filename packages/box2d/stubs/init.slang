func m.body_set_name(body_id, name){}

// body_get_name(body_id: BodyId) -> string
// Get the body name.
// C: `const char *b2Body_GetName(b2BodyId bodyId)`
func m.body_get_name(body_id){}

// body_set_user_data(body_id: BodyId, user_data: ffi.Pointer)
// Set the user data for a body
