// raylib: raylib 5.5 (https://www.raylib.com) and raymath, through
// slang/ffi. Generated by tool/gen_stubs.slang from the headers: the
// package makes these functions at run time, so tools read them here.
//
// Structs are tables (fields by name or by position); pointer fields
// reach into raylib's memory (model.materials[0].maps[0].texture = tex):
//   Vector2 {x, y}
//   Vector3 {x, y, z}
//   Vector4 {x, y, z, w}
//   Matrix {m0, m4, m8, m12, m1, m5, m9, m13, m2, m6, m10, m14, m3, m7, m11,
//      m15}
//   Color {r, g, b, a}
//   Rectangle {x, y, width, height}
//   Image {data, width, height, mipmaps, format}
//   Texture {id, width, height, mipmaps, format}
//   RenderTexture {id, texture, depth}
//   NPatchInfo {source, left, top, right, bottom, layout}
//   GlyphInfo {value, offset_x, offset_y, advance_x, image}
//   Font {base_size, glyph_count, glyph_padding, texture, recs, glyphs}
//   Camera3D {position, target, up, fovy, projection}
//   Camera2D {offset, target, rotation, zoom}
//   Mesh {vertex_count, triangle_count, vertices, texcoords, texcoords2,
//      normals, tangents, colors, indices, anim_vertices, anim_normals,
//      bone_ids, bone_weights, bone_matrices, bone_count, vao_id, vbo_id}
//   Shader {id, locs}
//   MaterialMap {texture, color, value}
//   Material {shader, maps, params}
//   Transform {translation, rotation, scale}
//   BoneInfo {name, parent}
//   Model {transform, mesh_count, material_count, meshes, materials,
//      mesh_material, bone_count, bones, bind_pose}
//   ModelAnimation {bone_count, frame_count, bones, frame_poses, name}
//   Ray {position, direction}
//   RayCollision {hit, distance, point, normal}
//   BoundingBox {min, max}
//   Wave {frame_count, sample_rate, sample_size, channels, data}
//   AudioStream {buffer, processor, sample_rate, sample_size, channels}
//   Sound {stream, frame_count}
//   Music {stream, frame_count, looping, ctx_type, ctx_data}
//   VrDeviceInfo {h_resolution, v_resolution, h_screen_size, v_screen_size,
//      eye_to_screen_distance, lens_separation_distance,
//      interpupillary_distance, lens_distortion_values, chroma_ab_correction}
//   VrStereoConfig {projection, view_offset, left_lens_center,
//      right_lens_center, left_screen_center, right_screen_center, scale,
//      scale_in}
//   FilePathList {capacity, count, paths}
//   AutomationEvent {frame, type, params}
//   AutomationEventList {capacity, count, events}
//   float3 {v}
//   float16 {v}
local m = {}

// the raylib version, "5.5"
m.version = "5.5"

// the declarations, for slang/ffi: ffi.new("Vector2", 4, m.decls)
m.decls = {}

