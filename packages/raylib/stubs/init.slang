// ------------------------------------------------------------ written in slang

// A frame, drawn by the block (BeginDrawing ... EndDrawing); in the browser the
// frame also ends the program's turn
//   drawing(block)
func m.drawing(block){}

// The block draws through a 2D camera
//   mode_2d(camera: Camera2D, block)
func m.mode_2d(camera, block){}

// The block draws in 3D through camera
//   mode_3d(camera: Camera3D, block)
func m.mode_3d(camera, block){}

// The block draws into target
//   texture_mode(target: RenderTexture, block)
func m.texture_mode(target, block){}

// The block draws with shader
//   shader_mode(shader: Shader, block)
func m.shader_mode(shader, block){}

// The block draws blending with mode (rl.BLEND_ADDITIVE, ...)
//   blend_mode(mode: int, block)
func m.blend_mode(mode, block){}

// The block draws only inside the rectangle
//   scissor_mode(x: int, y: int, width: int, height: int, block) or
//      scissor_mode(rectangle: Rectangle, block)
func m.scissor_mode(x, y, width, height, block){}

// The block draws for a VR headset
//   vr_stereo_mode(config: VrStereoConfig, block)
func m.vr_stereo_mode(config, block){}

// A 3D camera: from {0, 10, 10} looking at the origin, y up, 45 degrees,
// perspective, unless told otherwise
//   camera_3d(options?: {position?: Vector3, target?: Vector3, up?: Vector3,
//      fovy?: float, projection?: int}) -> Camera3D
func m.camera_3d(options){ return {@meta: camera_3d_meta, position: {x: 0, y: 0, z: 0}, target: {x: 0, y: 0, z: 0}, up: {x: 0, y: 0, z: 0}, fovy: 0, projection: 0} }

// A 2D camera (zoom 1 unless told otherwise)
//   camera_2d(options?: {offset?: Vector2, target?: Vector2, rotation?: float,
//      zoom?: float}) -> Camera2D
func m.camera_2d(options){ return {@meta: camera_2d_meta, offset: {x: 0, y: 0}, target: {x: 0, y: 0}, rotation: 0, zoom: 0} }

// Opens the window: the config flags are set first, and fps is the target frame
// rate (800 by 450, "raylib", by default)
//   open(options: {width?: int, height?: int, title?: string, msaa?: bool,
//      resizable?: bool, vsync?: bool, highdpi?: bool, fullscreen?: bool,
//      hidden?: bool, flags?: int, fps?: int}) or open(width: int, height: int,
//      title: string)
func ns_window_fns.open(options, height, title){}

// The raw pixel data of an image, in its format (image.format)
//   pixel_data(image: Image) -> string
func ns_image_fns.pixel_data(image){}

// Sets a uniform: by name (looked up once) or location; the type is inferred
// from the value (a float, an int, a vector of 2 to 4, a matrix, a texture)
// unless given
//   set(name: string | int, value: any, uniform_type?: int)
func shader_methods.set(self, name, value, uniform_type){}

// The location of a uniform, looked up once
//   location(name: string) -> int
func shader_methods.location(self, name){}

// The raw pixel data of the image, in its format (image.format)
//   pixel_data() -> string
func image_methods.pixel_data(self){}

// The ray from the screen through a point of it, into the world
//   screen_to_world_ray(position: Vector2) -> Ray
func camera_3d_methods.screen_to_world_ray(self, position){ return {position: {x: 0, y: 0, z: 0}, direction: {x: 0, y: 0, z: 0}} }

// Where a point of the world is on the screen
//   world_to_screen(position: Vector3) -> Vector2
func camera_3d_methods.world_to_screen(self, position){ return {x: 0, y: 0} }

// The point of the world under a point of the screen
//   screen_to_world(position: Vector2) -> Vector2
func camera_2d_methods.screen_to_world(self, position){ return {x: 0, y: 0} }

// Where a point of the world is on the screen
//   world_to_screen(position: Vector2) -> Vector2
func camera_2d_methods.world_to_screen(self, position){ return {x: 0, y: 0} }

