  return {
    transform: {
      m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0,
      m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0
    }, mesh_count: 0, material_count: 0, meshes: null, materials: null,
    mesh_material: null, bone_count: 0, bones: null, bind_pose: null
  }
}

