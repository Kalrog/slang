// Get glyph rectangle in font atlas for a codepoint (unicode character),
// fallback to '?' if not found
//   glyph_atlas_rec(font: Font, codepoint: int) -> Rectangle
//   C: Rectangle GetGlyphAtlasRec(Font font, int codepoint)
func m.glyph_atlas_rec(font, codepoint){ return {x: 0, y: 0, width: 0, height: 0} }

// Get glyph index position in font for a codepoint (unicode character),
// fallback to '?' if not found
//   glyph_index(font: Font, codepoint: int) -> int
//   C: int GetGlyphIndex(Font font, int codepoint)
func m.glyph_index(font, codepoint){}

// Get glyph font info data for a codepoint (unicode character), fallback to '?'
// if not found
//   glyph_info(font: Font, codepoint: int) -> GlyphInfo
//   C: GlyphInfo GetGlyphInfo(Font font, int codepoint)
func m.glyph_info(font, codepoint){ return {value: 0, offset_x: 0, offset_y: 0, advance_x: 0, image: {data: null, width: 0, height: 0, mipmaps: 0, format: 0}} }

// Check file extension (including point: .png, .wav)
//   is_file_extension(file_name: string, ext: string) -> bool
//   C: bool IsFileExtension(const char *fileName, const char *ext)
func m.is_file_extension(file_name, ext){}

// Check if fileName is valid for the platform/OS
//   is_file_name_valid(file_name: string) -> bool
//   C: bool IsFileNameValid(const char *fileName)
func m.is_file_name_valid(file_name){}

// Check if a given path is a file or a directory
//   is_path_file(path: string) -> bool
//   C: bool IsPathFile(const char *path)
func m.is_path_file(path){}

// Calculate linear interpolation between two floats
//   lerp(start: float, end: float, amount: float) -> float
//   C: float Lerp(float start, float end, float amount)
func m.lerp(start, end, amount){}

// Load automation events list from file, NULL for empty list, capacity =
// MAX_AUTOMATION_EVENTS
//   load_automation_event_list(file_name: string) -> AutomationEventList
//   C: AutomationEventList LoadAutomationEventList(const char *fileName)
func m.load_automation_event_list(file_name){ return {capacity: 0, count: 0, events: null} }

// Load all codepoints from a UTF-8 text string, codepoints count returned by
// parameter
//   load_codepoints(text: string, count: pointer) -> pointer
//   C: int *LoadCodepoints(const char *text, int *count)
func m.load_codepoints(text, count){}

// The paths of the files in a directory
//   load_directory_files(dir_path: string) -> list of strings
//   C: FilePathList LoadDirectoryFiles(const char *dirPath)
func m.load_directory_files(dir_path){ return {capacity: 0, count: 0, paths: null} }

// The paths in a directory, filtered by extension (".png;.wav"), optionally of
// its subdirectories too
//   load_directory_files_ex(base_path: string, filter: string, scan_subdirs:
//      bool) -> list of strings
//   C: FilePathList LoadDirectoryFilesEx(const char *basePath, const char
//      *filter, bool scanSubdirs)
func m.load_directory_files_ex(base_path, filter, scan_subdirs){ return {capacity: 0, count: 0, paths: null} }

// The paths of the files dropped on the window
