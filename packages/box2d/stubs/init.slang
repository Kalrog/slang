// ------------------------------------------------------------ functions

// set_allocator(alloc_fcn: function, free_fcn: function)
// This allows the user to override the allocation functions. These should be
// set during application startup.
// C: `void b2SetAllocator(function *allocFcn, function *freeFcn)`
func m.set_allocator(alloc_fcn, free_fcn){}

// get_byte_count() -> int
// Returns the total bytes allocated by Box2D
// C: `size_t b2GetByteCount()`
func m.get_byte_count(){}

// set_assert_callback(assert_fcn: function)
// Override the default assert function
// C: `void b2SetAssertCallback(function *assertFcn)`
// [assert_fcn]: a non-null assert callback
func m.set_assert_callback(assert_fcn){}

// set_log_callback(log_fcn: function)
// Override the default log function
// C: `void b2SetLogCallback(function *logFcn)`
// [log_fcn]: a non-null log callback
func m.set_log_callback(log_fcn){}

// get_version() -> Version
// Get the current version of Box2D
// C: `b2Version b2GetVersion()`
func m.get_version(){}

// is_double_precision() -> bool
// Returns true if the library was built with BOX2D_DOUBLE_PRECISION (large
// world mode)
// C: `bool b2IsDoublePrecision()`
func m.is_double_precision(){}

// is_avx2_available() -> bool
// Returns true if the current CPU has the AVX2 instruction set.
// C: `bool b2IsAVX2Available()`
func m.is_avx2_available(){}

// internal_assert(condition: string, file_name: string, line_number: int) ->
//   int
// C: `int b2InternalAssert(const char *condition, const char *fileName, int
// lineNumber)`
func m.internal_assert(condition, file_name, line_number){}

// get_ticks() -> int
// Get the absolute number of system ticks. The value is platform specific.
// C: `uint64_t b2GetTicks()`
func m.get_ticks(){}

// get_milliseconds(ticks: int) -> float
// Get the milliseconds passed from an initial tick value.
// C: `float b2GetMilliseconds(uint64_t ticks)`
func m.get_milliseconds(ticks){}

// get_milliseconds_and_reset(ticks: ffi.Pointer) -> float
// Get the milliseconds passed from an initial tick value. Resets the passed in
// value to the current tick value.
// C: `float b2GetMillisecondsAndReset(uint64_t *ticks)`
func m.get_milliseconds_and_reset(ticks){}

// yield()
// Yield to be used in a busy loop.
// C: `void b2Yield()`
func m.yield(){}

// hash(hash: int, data: ffi.Pointer, count: int) -> int
// Simple djb2 hash function for determinism testing
// C: `uint32_t b2Hash(uint32_t hash, const uint8_t *data, int count)`
func m.hash(hash, data, count){}

// is_valid_ray(input: RayCastInput) -> bool
// Validate ray cast input data (NaN, etc)
// C: `bool b2IsValidRay(const b2RayCastInput *input)`
func m.is_valid_ray(input){}

// make_polygon(hull: ffi.Pointer, radius: float) -> Polygon
// Make a convex polygon from a convex hull. This will assert if the hull is not
// valid. Warning: Do not manually fill in the hull data, it must come directly
// from b2ComputeHull
// C: `b2Polygon b2MakePolygon(const b2Hull *hull, float radius)`
func m.make_polygon(hull, radius){}

// make_offset_polygon(hull: ffi.Pointer, position: Vec2, rotation: Rot) ->
//   Polygon
// Make an offset convex polygon from a convex hull. This will assert if the
// hull is not valid. Warning: Do not manually fill in the hull data, it must
// come directly from b2ComputeHull
// C: `b2Polygon b2MakeOffsetPolygon(const b2Hull *hull, b2Vec2 position, b2Rot
// rotation)`
func m.make_offset_polygon(hull, position, rotation){}

// make_offset_rounded_polygon(hull: ffi.Pointer, position: Vec2, rotation: Rot,
//   radius: float) -> Polygon
// Make an offset convex polygon from a convex hull with a radius. This will
// assert if the hull is not valid. Warning: Do not manually fill in the hull
// data, it must come directly from b2ComputeHull
// C: `b2Polygon b2MakeOffsetRoundedPolygon(const b2Hull *hull, b2Vec2 position,
// b2Rot rotation, float radius)`
func m.make_offset_rounded_polygon(hull, position, rotation, radius){}

// make_square(half_width: float) -> Polygon
