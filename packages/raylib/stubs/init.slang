//   C: Vector3 Vector3MoveTowards(Vector3 v, Vector3 target, float maxDistance)
func ns_vector3_fns.move_towards(v, target, max_distance){ return {x: 0, y: 0, z: 0} }

// Multiply vector by vector
//   multiply(v1: Vector3, v2: Vector3) -> Vector3
//   C: Vector3 Vector3Multiply(Vector3 v1, Vector3 v2)
func ns_vector3_fns.multiply(v1, v2){ return {x: 0, y: 0, z: 0} }

