// ------------------------------------------------------------ rl.matrix

// Add two matrices
//   add(left: Matrix, right: Matrix) -> Matrix
//   C: Matrix MatrixAdd(Matrix left, Matrix right)
func ns_matrix_fns.add(left, right){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Decompose a transformation matrix into its rotational, translational and
// scaling components
//   decompose(mat: Matrix, translation: Vector3 (updated), rotation: Vector4
//      (updated), scale: Vector3 (updated))
//   C: void MatrixDecompose(Matrix mat, Vector3 *translation, Vector4
//      *rotation, Vector3 *scale)
func ns_matrix_fns.decompose(mat, translation, rotation, scale){}

// Compute matrix determinant
//   determinant(mat: Matrix) -> float
//   C: float MatrixDeterminant(Matrix mat)
func ns_matrix_fns.determinant(mat){}

// Get perspective projection matrix
//   frustum(left: float, right: float, bottom: float, top: float, near_plane:
//      float, far_plane: float) -> Matrix
//   C: Matrix MatrixFrustum(double left, double right, double bottom, double
//      top, double nearPlane, double farPlane)
func ns_matrix_fns.frustum(left, right, bottom, top, near_plane, far_plane){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get identity matrix
//   identity() -> Matrix
//   C: Matrix MatrixIdentity()
func ns_matrix_fns.identity(){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Invert provided matrix
//   invert(mat: Matrix) -> Matrix
//   C: Matrix MatrixInvert(Matrix mat)
func ns_matrix_fns.invert(mat){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get camera look-at matrix (view matrix)
//   look_at(eye: Vector3, target: Vector3, up: Vector3) -> Matrix
//   C: Matrix MatrixLookAt(Vector3 eye, Vector3 target, Vector3 up)
func ns_matrix_fns.look_at(eye, target, up){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get two matrix multiplication NOTE: When multiplying matrices... the order
// matters!
//   multiply(left: Matrix, right: Matrix) -> Matrix
//   C: Matrix MatrixMultiply(Matrix left, Matrix right)
func ns_matrix_fns.multiply(left, right){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get orthographic projection matrix
//   ortho(left: float, right: float, bottom: float, top: float, near_plane:
//      float, far_plane: float) -> Matrix
//   C: Matrix MatrixOrtho(double left, double right, double bottom, double top,
//      double nearPlane, double farPlane)
func ns_matrix_fns.ortho(left, right, bottom, top, near_plane, far_plane){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get perspective projection matrix NOTE: Fovy angle must be provided in
