  local o1 = ops[b + 0]
  local p1 = o1.phase
  local i1 = o1.inc
  local a1 = o1.amp
  local d1 = o1.damp
  local o2 = ops[b + 1]
  local p2 = o2.phase
  local i2 = o2.inc
  local a2 = o2.amp
  local d2 = o2.damp
  local o3 = ops[b + 2]
  local p3 = o3.phase
  local i3 = o3.inc
  local a3 = o3.amp
  local d3 = o3.damp
  local o4 = ops[b + 3]
  local p4 = o4.phase
  local i4 = o4.inc
  local a4 = o4.amp
  local d4 = o4.damp
  local o5 = ops[b + 4]
  local p5 = o5.phase
  local i5 = o5.inc
  local a5 = o5.amp
  local d5 = o5.damp
  local o6 = ops[b + 5]
  local p6 = o6.phase
  local i6 = o6.inc
  local a6 = o6.amp
  local d6 = o6.damp
  local vo = voices[v]
  local y1 = vo.y1
  local y2 = vo.y2
  local fb = vo.fb
  for(local i = 0; i < n; i += 1){
    p6 = fract(p6 + i6)
    local x6 = sin((p6 + (y1 + y2) * fb) * TAU) * a6
    a6 += d6
    y2 = y1
    y1 = x6
    p5 = fract(p5 + i5)
    local x5 = sin((p5 + x6) * TAU) * a5
    a5 += d5
    p4 = fract(p4 + i4)
    local x4 = sin((p4 + x6) * TAU) * a4
    a4 += d4
    p3 = fract(p3 + i3)
    local x3 = sin((p3) * TAU) * a3
    a3 += d3
    p2 = fract(p2 + i2)
    local x2 = sin((p2 + x3) * TAU) * a2
    a2 += d2
    p1 = fract(p1 + i1)
    local x1 = sin((p1 + x2) * TAU) * a1
    a1 += d1
    out[i] += (x1 + x4 + x5) * 0.14433756729740646
  }
  o1.phase = p1
  o1.amp = a1
  o2.phase = p2
  o2.amp = a2
  o3.phase = p3
  o3.amp = a3
  o4.phase = p4
  o4.amp = a4
  o5.phase = p5
  o5.amp = a5
  o6.phase = p6
  o6.amp = a6
  vo.y1 = y1
  vo.y2 = y2
}
