//      Vector3 p3, Vector3 p4)
func ns_collision_fns.ray_quad(ray, p1, p2, p3, p4){ return {hit: false, distance: 0, point: {x: 0, y: 0, z: 0}, normal: {x: 0, y: 0, z: 0}} }

