// Generates stubs/init.slang: the declarations of the raylib module for
// the language server and `slang doc`, which cannot see functions the
// package makes at run time. It reads the installed raylib's headers the
// way the package does (slang/ffi) and takes raylib's comments as docs.
// Run in packages/raylib after raylib or the package changes:
//     slang run tool/gen_stubs.slang
local str = require("slang/string")
local os = require("slang/os")
local rl = require("raylib")
local names = require("raylib/names")
local snake = names.snake

local C = rl.decls
local out = {}
local func line(...parts){
  append(out, str.join(parts, ""))
}

local func words(s){
  local list = {}
  for(let local w in values(str.split(s, " "))){
    if(w != ""){
      append(list, w)
    }
  }
  return list
}

// a comment wrapped at 80 columns; in a code sample (indent "//   ") the
// lines after the first are indented by three more
local func comment(text, indent){
  indent = indent or "// "
  local current = indent
  for(let local w in values(words(text))){
    if(len(current) + len(w) + 1 > 80 and len(current) > len(indent)){
      line(current)
      if(indent != "// " and len(indent) < 8){
        indent = concat(indent, "   ")
      }
      current = indent
    }
    if(current == indent){
      current = concat(current, w)
    } else {
      current = concat(current, " ", w)
    }
  }
  if(current != indent){
    line(current)
  }
}

// the C spelling of a parsed type
local spell = null
spell = func(t){
  local prefix = ""
  if(t.const){
    prefix = "const "
  }
  if(t.kind == "ptr"){
    return concat(spell(t.to), " *")
  }
  if(t.kind == "array"){
    return concat(spell(t.of), "[", string(t.n), "]")
  }
  if(t.kind == "struct"){
    return concat(prefix, t.name)
  }
  return concat(prefix, t.c)
}

// a parameter in C: "const char *text", "int posX"
local func cparam(t, name){
  local s = spell(t)
  if(name == null){
    return s
  }
  if(str.ends_with(s, "*")){
    return concat(s, name)
  }
  return concat(s, " ", name)
}

// what a C type is on the slang side
local func slang_type(t){
  local k = t.kind
  if(k == "prim"){
    if(t.name == "bool"){
      return "bool"
    }
    if(t.name == "float" or t.name == "double"){
      return "float"
    }
    return "int"
  }
  if(k == "struct"){
    return t.name
  }
  if(k == "ptr"){
    local to = t.to
    if(to.char and t.const_to){
      return "string"
    }
    if(to.kind == "struct" and not t.const_to){
      return concat(to.name, " (updated)")
    }
    return "pointer"
  }
  return "?"
}

// an example value of a struct: a table with its fields, so tools know them
local example = null
example = func(t){
  if(t.kind != "struct" or t.fields == null){
    return "null"
  }
  local parts = {}
  for(let local f in values(t.fields)){
    local v = "0"
    local ft = f.type
    if(ft.kind == "struct"){
      v = example(ft)
    } else if(ft.kind == "ptr"){
      v = "null"
    } else if(ft.kind == "array"){
      v = "{}"
    } else if(ft.kind == "prim" and ft.name == "bool"){
      v = "false"
    }
    append(parts, concat(snake(f.name), ": ", v))
  }
  return concat("{", str.join(parts, ", "), "}")
}

local func fields_of(t){
  local list = {}
  for(let local f in values(t.fields)){
    append(list, snake(f.name))
  }
  return str.join(list, ", ")
}

line(
  "// raylib: raylib ", rl.version,
  " (https://www.raylib.com) and raymath, through"
)
line("// slang/ffi. Generated by tool/gen_stubs.slang from the headers: the")
line("// package makes these functions at run time, so tools read them here.")
line("//")
line("// Structs are tables (fields by name or by position); pointer fields")
line(
  "// reach into raylib's memory (model.materials[0].maps[0].texture = tex):",
)
local seen = {}
for(let local e in entries(C.types)){
  local t = e[1]
  if(t.kind == "struct" and t.fields != null and not seen[t.name] and
    not str.starts_with(e[0], "struct ")){
    seen[t.name] = true
  }
}
// in the order of the header
local ordered = {}
for(let local e in entries(C.types)){
  if(str.starts_with(e[0], "struct ")){
    local name = str.substring(e[0], 7)
    if(seen[name]){
      append(ordered, name)
    }
  }
}
for(let local name in values(ordered)){
  comment(concat(name, " {", fields_of(C.types[name]), "}"), "//   ")
}
line("local m = {}")
line("")
line("// the raylib version, \"", rl.version, "\"")
line("m.version = \"", rl.version, "\"")
line("")
line("// the declarations, for slang/ffi: ffi.new(\"Vector2\", 4, m.decls)")
line("m.decls = {}")
line("")
line(
  "// ------------------------------------------------------------ constants",
)
line("")
local constants = {}
for(let local e in entries(C.constants)){
  append(constants, e[0])
}
for(let local name in values(constants)){
  local v = C.constants[name]
  if(type(v) == "string"){
    line("m.", name, " = \"", v, "\"")
  } else if(type(v) == "table"){
    local parts = {}
    for(let local f in entries(v)){
      append(parts, concat(f[0], ": ", string(f[1])))
    }
    line("m.", name, " = {", str.join(parts, ", "), "}")
  } else if(v != null){
    line("m.", name, " = ", string(v))
  }
}
line("")
line(
  "// ------------------------------------------------------------ functions",
)
line("")
local handwritten = {
  load_file_text: true,
  load_directory_files: true,
  load_directory_files_ex: true,
  load_dropped_files: true,
  load_image_colors: true,
  load_model_animations: true,
  set_shader_value: true,
  set_shader_value_v: true,
  trace_log: true,
}
for(let local c_name in values(C.order)){
  local f = C.functions[c_name]
  local name = snake(c_name)
  if(not handwritten[name]){
    local params = {}
    local docs = {}
    local cparams = {}
    local i = 0
    for(i < len(f.params)){
      local p = f.params[i]
      local pname = snake(p.name or concat("arg", string(i)))
      append(cparams, cparam(p.type, p.name))
      if(p.type.kind == "ptr" and names.is_count(f.params[i + 1])){
        local to = p.type.to
        local what = "list"
        if(to.char or to.kind == "void"){
          what = "string"
        } else if(to.kind == "struct"){
          what = concat("list of ", to.name)
        }
        append(params, pname)
        append(docs, concat(pname, ": ", what))
        append(cparams, cparam(f.params[i + 1].type, f.params[i + 1].name))
        i = i + 2
      } else {
        append(params, pname)
        append(docs, concat(pname, ": ", slang_type(p.type)))
        i = i + 1
      }
    }
    if(f.variadic){
      append(params, "...args")
      append(docs, "...args")
      append(cparams, "...")
    }
    local sig = concat(name, "(", str.join(docs, ", "), ")")
    local ret = f.ret
    if(ret.kind != "void"){
      local r = slang_type(ret)
      if(ret.kind == "ptr" and ret.to.char){
        r = "string"
      }
      sig = concat(sig, " -> ", r)
    }
    if(f.doc != ""){
      comment(f.doc)
    }
    comment(sig, "//   ")
    comment(
      concat("C: ", cparam(ret, c_name), "(", str.join(cparams, ", "), ")"),
      "//   ",
    )
    local body = ""
    if(ret.kind == "struct"){
      body = concat(" return ", example(ret.original or ret), " ")
    }
    line("func m.", name, "(", str.join(params, ", "), "){", body, "}")
    line("")
  }
}
line(
  "// ------------------------------------------------------------ written by hand",
)
line("")
local manual = {
  {
    "load_file_text(file_name: string) -> string",
    "Load text data from file",
    "file_name",
    " return \"\" ",
  },
  {
    "load_directory_files(dir_path: string) -> list of strings",
    "The paths of the files in a directory",
    "dir_path",
    " return {} ",
  },
  {
    "load_directory_files_ex(base_path: string, filter: string, scan_subdirs: bool) -> list of strings",
    "The paths in a directory, filtered by extension (\".png;.wav\"), optionally of its subdirectories too",
    "base_path, filter, scan_subdirs",
    " return {} ",
  },
  {
    "load_dropped_files() -> list of strings",
    "The paths of the files dropped on the window",
    "",
    " return {} ",
  },
  {
    "load_image_colors(image: Image) -> list of Color",
    "The pixels of an image as colors, row by row",
    "image",
    " return {} ",
  },
  {
    "get_image_data(image: Image) -> string",
    "The raw pixel data of an image, in its format (image.format)",
    "image",
    " return \"\" ",
  },
  {
    "load_model_animations(file_name: string) -> list of ModelAnimation",
    "Load model animations from file; each is unloaded with unload_model_animation",
    "file_name",
    " return {} ",
  },
  {
    "set_shader_value(shader: Shader, loc_index: int, value, uniform_type: int)",
    "Set shader uniform value: a number for SHADER_UNIFORM_FLOAT, _INT and _SAMPLER2D, a list or vector table ({x, y, z, w}, or a Color) for the VEC and IVEC types",
    "shader, loc_index, value, uniform_type",
    "",
  },
  {
    "set_shader_value_v(shader: Shader, loc_index: int, list, uniform_type: int)",
    "Set shader uniform array: a list of values as set_shader_value takes them",
    "shader, loc_index, list, uniform_type",
    "",
  },
  {
    "trace_log(level: int, text: string)",
    "Show a trace log message (LOG_DEBUG, LOG_INFO, LOG_WARNING, LOG_ERROR...); the text is not a format",
    "level, text",
    "",
  },
}
for(let local f in values(manual)){
  comment(f[1])
  comment(f[0], "//   ")
  local name = str.substring(f[0], 0, str.index_of(f[0], "("))
  line("func m.", name, "(", f[2], "){", f[3], "}")
  line("")
}
// the constructors made in slang
local made = {
  {
    "init_window(options: {width?: int, height?: int, title?: string, msaa?: bool, resizable?: bool, vsync?: bool, highdpi?: bool, fullscreen?: bool, fps?: int})",
    "Opens the window from options (init_window(width, height, title) works too): the config flags are set first, fps is the target frame rate",
  },
  {
    "camera_3d(options?: {position?: Vector3, target?: Vector3, up?: Vector3, fovy?: float, projection?: int}) -> Camera3D",
    "A 3D camera: from {0, 10, 10} looking at the origin, y up, 45 degrees, perspective, unless told otherwise",
  },
  {
    "camera_2d(options?: {offset?: Vector2, target?: Vector2, rotation?: float, zoom?: float}) -> Camera2D",
    "A 2D camera (zoom 1 unless told otherwise)",
  },
  {
    "mesh(options: {vertices: {float}, normals?: {float}, texcoords?: {float}, texcoords2?: {float}, colors?: {int}, tangents?: {float}, indices?: {int}, upload?: bool, dynamic?: bool}) -> Mesh",
    "A mesh from lists (or buffers) of numbers, copied into memory the mesh owns and uploaded to the GPU unless upload is false",
  },
  {
    "wave(options: {samples: {float}, sample_rate?: int, channels?: int}) -> Wave",
    "Sound data from samples in -1..1, as 16-bit samples the wave owns (44100 Hz, mono by default)",
  },
  {
    "sound(options: {samples: {float}, sample_rate?: int, channels?: int}) -> Sound",
    "A sound from samples as wave takes them; needs the audio device",
  },
}
for(let local f in values(made)){
  comment(f[1])
  comment(f[0], "//   ")
  local name = str.substring(f[0], 0, str.index_of(f[0], "("))
  local params = "options"
  if(name == "init_window"){
    params = "width, height, title"
  }
  line("func m.", name, "(", params, "){}")
  line("")
}

// the resource types: their functions as methods and properties
local class_count = 0
for(let local e in entries(rl.__resource_words)){
  local type_name = e[0]
  local class = rl.__class_of(type_name)
  local table = concat(snake(type_name), "_methods")
  line("// ------------------------------------------------------------ ", type_name)
  line("")
  comment(concat(
    "A ", type_name, " is the struct as a table with the functions that ",
    "take it first as methods, named without the type's word, and its ",
    "getters without arguments and setters of one value as properties.",
  ))
  line("// type ", type_name)
  local key_list = {}
  for(let local k in keys(class.sources)){
    append(key_list, k)
  }
  require("slang/table").sort(key_list)
  for(let local k in values(key_list)){
    local src = class.sources[k]
    if(src.kind != "method"){
      local readable = class.properties[k].get != null
      local writable = class.properties[k].set != null
      local t = "any"
      if(readable){
        local d = class.sources[k].decl
        if(src.kind == "get"){
          t = slang_type(d.ret)
        }
      }
      if(src.kind == "set"){
        t = slang_type(src.decl.params[1].type)
      }
      local note = ""
      if(not writable){
        note = " (read-only)"
      } else if(not readable){
        note = " (write-only)"
      }
      comment(concat("[", k, "]: ", t, note))
    }
  }
  line("local ", table, " = {}")
  line("")
  for(let local k in values(key_list)){
    local src = class.sources[k]
    if(src.kind == "method"){
      local d = src.decl
      local params = {}
      local docs = {}
      for(local i = 1; i < len(d.params); i = i + 1){
        local p = d.params[i]
        local pname = snake(p.name or concat("arg", string(i)))
        if(p.type.kind == "ptr" and i + 1 < len(d.params) and names.is_count(d.params[i + 1])){
          append(params, pname)
          append(docs, concat(pname, ": list"))
          i = i + 1
        } else {
          append(params, pname)
          append(docs, concat(pname, ": ", slang_type(p.type)))
        }
      }
      local sig = concat(k, "(", str.join(docs, ", "), ")")
      if(d.ret.kind != "void"){
        sig = concat(sig, " -> ", slang_type(d.ret))
      }
      if(d.doc != ""){
        comment(d.doc)
      }
      comment(sig, "//   ")
      comment(concat("C: ", d.name), "//   ")
      line("func ", table, ".", k, "(", str.join({"self", ...params}, ", "), "){}")
      line("")
    }
  }
  class_count = class_count + 1
}
// written in slang
line("// set(name: string | int, value: any, uniform_type?: int)")
line("// Sets a uniform: by name (looked up once) or location; the type is")
line("// inferred from the value unless given.")
line("func shader_methods.set(self, name, value, uniform_type){}")
line("")
line("// Every raylib function and constant under its C name.")
line("m.c = {}")
line("")
line("return m")
os.write_file("stubs/init.slang", concat(str.join(out, "\n"), "\n"))
print("stubs/init.slang: ", string(len(C.order)), " functions\n")
