// Check collision between two spheres
//   spheres(center1: Vector3, radius1: float, center2: Vector3, radius2: float)
//      -> bool
//   C: bool CheckCollisionSpheres(Vector3 center1, float radius1, Vector3
//      center2, float radius2)
func ns_collision_fns.spheres(center1, radius1, center2, radius2){}

// ------------------------------------------------------------ rl.color

// Get color with alpha applied, alpha goes from 0.0f to 1.0f
//   alpha(color: Color, alpha: float) -> Color
//   C: Color ColorAlpha(Color color, float alpha)
func ns_color_fns.alpha(color, alpha){ return {r: 0, g: 0, b: 0, a: 0} }

// Get src alpha-blended into dst color with tint
//   alpha_blend(dst: Color, src: Color, tint: Color) -> Color
//   C: Color ColorAlphaBlend(Color dst, Color src, Color tint)
func ns_color_fns.alpha_blend(dst, src, tint){ return {r: 0, g: 0, b: 0, a: 0} }

// Get color with brightness correction, brightness factor goes from -1.0f to
// 1.0f
//   brightness(color: Color, factor: float) -> Color
//   C: Color ColorBrightness(Color color, float factor)
func ns_color_fns.brightness(color, factor){ return {r: 0, g: 0, b: 0, a: 0} }

// Get color with contrast correction, contrast values between -1.0f and 1.0f
//   contrast(color: Color, contrast: float) -> Color
//   C: Color ColorContrast(Color color, float contrast)
func ns_color_fns.contrast(color, contrast){ return {r: 0, g: 0, b: 0, a: 0} }

// Check if two colors are equal
//   equal(col1: Color, col2: Color) -> bool
//   C: bool ColorIsEqual(Color col1, Color col2)
func ns_color_fns.equal(col1, col2){}

// Get color with alpha applied, alpha goes from 0.0f to 1.0f
//   fade(color: Color, alpha: float) -> Color
//   C: Color Fade(Color color, float alpha)
func ns_color_fns.fade(color, alpha){ return {r: 0, g: 0, b: 0, a: 0} }

// Get Color structure from hexadecimal value
//   from_hex(hex_value: int) -> Color
//   C: Color GetColor(unsigned int hexValue)
func ns_color_fns.from_hex(hex_value){ return {r: 0, g: 0, b: 0, a: 0} }

// Get a Color from HSV values, hue [0..360], saturation/value [0..1]
//   from_hsv(hue: float, saturation: float, value: float) -> Color
//   C: Color ColorFromHSV(float hue, float saturation, float value)
func ns_color_fns.from_hsv(hue, saturation, value){ return {r: 0, g: 0, b: 0, a: 0} }

// Get Color from normalized values [0..1]
//   from_normalized(normalized: Vector4) -> Color
//   C: Color ColorFromNormalized(Vector4 normalized)
func ns_color_fns.from_normalized(normalized){ return {r: 0, g: 0, b: 0, a: 0} }

// Get color lerp interpolation between two colors, factor [0.0f..1.0f]
//   lerp(color1: Color, color2: Color, factor: float) -> Color
//   C: Color ColorLerp(Color color1, Color color2, float factor)
func ns_color_fns.lerp(color1, color2, factor){ return {r: 0, g: 0, b: 0, a: 0} }

// Get Color normalized as float [0..1]
//   normalize(color: Color) -> Vector4
//   C: Vector4 ColorNormalize(Color color)
func ns_color_fns.normalize(color){ return {x: 0, y: 0, z: 0, w: 0} }

// Get Color from a source pixel pointer of certain format
//   pixel(src_ptr: pointer, format: int) -> Color
//   C: Color GetPixelColor(void *srcPtr, int format)
func ns_color_fns.pixel(src_ptr, format){ return {r: 0, g: 0, b: 0, a: 0} }

// Set color formatted into destination pixel pointer
//   set_pixel(dst_ptr: pointer, color: Color, format: int)
//   C: void SetPixelColor(void *dstPtr, Color color, int format)
func ns_color_fns.set_pixel(dst_ptr, color, format){}

// Get color multiplied with another color
//   tint(color: Color, tint: Color) -> Color
//   C: Color ColorTint(Color color, Color tint)
func ns_color_fns.tint(color, tint){ return {r: 0, g: 0, b: 0, a: 0} }

// Get HSV values for a Color, hue [0..360], saturation/value [0..1]
//   to_hsv(color: Color) -> Vector3
//   C: Vector3 ColorToHSV(Color color)
func ns_color_fns.to_hsv(color){ return {x: 0, y: 0, z: 0} }

// Get hexadecimal value for a Color (0xRRGGBBAA)
//   to_int(color: Color) -> int
//   C: int ColorToInt(Color color)
func ns_color_fns.to_int(color){}

