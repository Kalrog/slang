func m.body_get_local_point(body_id, world_point){}

// body_get_world_point(body_id: BodyId, local_point: Vec2) -> Vec2
// Get a world point on a body given a local point
// C: `b2Vec2 b2Body_GetWorldPoint(b2BodyId bodyId, b2Vec2 localPoint)`
func m.body_get_world_point(body_id, local_point){}

// body_get_local_vector(body_id: BodyId, world_vector: Vec2) -> Vec2
