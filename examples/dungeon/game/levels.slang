// The three levels of the mines (dsl/level).
extension "dsl/level"

legend mine {
  "#": wall, ".": floor, ">": stairs,
  "@": Player, "g": Goblin, "b": Bat,
  "k": Key, "D": Door, "p": Potion, "s": Sword, "c": Chest, "$": Coins,
  "E": Elder, "S": Sage,
}

level entrance mine {
  ####################
  #@.......#.........#
  #........#..g......#
  #...E....#.........#
  #........D....g....#
  #........#.........#
  #..####..#..####...#
  #..#..#..#..#..#...#
  #..#k.#..#..#$.#...#
  #..#.....#..#....b>#
  ####################
}

level bat_cave mine {
  ####################
  #@..#...b..........#
  #...#....####......#
  #.c.#....#..#..b...#
  #...#....#p.#......#
  #k..D....#..#......#
  #...#....#..#.b....#
  #...#....#..#......#
  #...#..............#
  #...#..b....g.....>#
  ####################
}

level hoard mine {
  ####################
  #@......#..........#
  #.......#...g......#
  #..s....#......c...#
  #.......D..........#
  #.......#.g........#
  #..k....#......S...#
  #.......#..........#
  #.g.....#.b.....c..#
  #.......#........>.#
  ####################
}
