{
  // Runs the slang binary from the workspace root under lldb-dap, so
  // `require` resolves paths the same way as on the command line.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Slang: Run Current File",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/zig/zig-out/bin/slang",
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "${file}"
      ]
    }
  ]
}
