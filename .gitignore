*.exe
.DS_Store
/bin/
/lib/
/test/*.slb
/zig/zig-out
/zig/.zig-cache
/zig/zig-out-*
examples/webserver/todos.db
examples/webserver/uploads/
examples/desktop/todos.db
# MIDI learn's bindings, each player's own
examples/synth/midi_map.json
examples/fm/midi_map*.json
/packages/*/lib/
# jolt ships its prebuilt joltc (packages/jolt/tool/build.sh)
!/packages/jolt/lib/
# kernel ships its prebuilt interpreter (packages/kernel/tool/build.sh)
!/packages/kernel/lib/
# midi ships its prebuilt CoreMIDI module (packages/midi/tool/build.sh)
!/packages/midi/lib/
# microphone ships its prebuilt CoreAudio module (packages/microphone/tool/build.sh)
!/packages/microphone/lib/
# window ships its prebuilt SDL3 (packages/window/tool/build.sh)
!/packages/window/lib/
# gpu ships wgpu-native's prebuilt library (packages/gpu/tool/fetch.sh)
!/packages/gpu/lib/
# the granular synthesizer's last take
examples/granular/takes/

# built programs (slang build)
/examples/webserver/webserver
/examples/desktop/todos
/dist/

# plans and notes, kept locally
/plans/

# the website: built pages and the wasm VM (make website, make wasm)
/website/out/
/website/public/slang.wasm
/website/public/slang-gfx.*
/website/web/.cache/
# Switchback's site (make switchback-web)
/examples/switchback/web/
/examples/switchback/daily.db*

# build outputs
/build/

# recordings made by examples/synth/mixdown.slang
/examples/synth/mixdown/
examples/futamura/grammar_generated.slang
# what make studio-demo renders
packages/studio/demo.wav
# what the tracker exports
examples/tracker/songs/*.wav
