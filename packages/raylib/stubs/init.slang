func ns_render_texture_fns.load(width, height){ return {@meta: render_texture_meta, id: 0, texture: {id: 0, width: 0, height: 0, mipmaps: 0, format: 0}, depth: {id: 0, width: 0, height: 0, mipmaps: 0, format: 0}} }

