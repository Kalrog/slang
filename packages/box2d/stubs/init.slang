// world_get_snapshot(world_id: WorldId, image: ffi.Pointer, capacity: int) ->
//   int
// Write a snapshot of the world's simulation state into a caller-owned buffer.
// Call once with image == NULL to get the required size, then again with a
// buffer of at least that size. Must be called at a step boundary. Returns The
// number of bytes the snapshot needs. If it exceeds capacity nothing is
// written. Returns 0 if the world is mid-step.
// C: `int b2World_GetSnapshot(b2WorldId worldId, uint8_t *image, int capacity)`
// [world_id]: The world to snapshot
// [image]: Destination buffer, or NULL to query the size
// [capacity]: Size of image in bytes, ignored when querying
func m.world_get_snapshot(world_id, image, capacity){}

// world_restore_from_snapshot(world_id: WorldId, image: ffi.Pointer, size: int)
//   -> bool
// Restore a world's simulation state from a snapshot image. The b2WorldId and
// ids held from this same world stay valid for objects that existed at the
// snapshot instant. Callbacks and threading configuration are preserved. User
// data on shapes, bodies, and joints is nulled. Returns true on success. On a
// rejected image (bad magic, version, or layout) the world is left unchanged. A
// corrupt payload detected after the rebuild begins returns false and leaves
// the world unusable, so the caller must destroy it.
// C: `bool b2World_RestoreFromSnapshot(b2WorldId worldId, const uint8_t *image,
// int size)`
// [world_id]: The world to restore into
// [image]: A snapshot image produced by b2World_GetSnapshot
// [size]: Size of image in bytes
func m.world_restore_from_snapshot(world_id, image, size){}

// create_world_from_snapshot(image: ffi.Pointer, size: int, worker_count: int)
//   -> WorldId
// Create a new world from a snapshot image. This is mainly useful for replay.
// Callbacks are reset to default. Returns The new world id, or b2_nullWorldId
// on failure.
// C: `b2WorldId b2CreateWorldFromSnapshot(const uint8_t *image, int size, int
// workerCount)`
// [image]: A snapshot image produced by b2World_GetSnapshot
// [size]: Size of image in bytes
// [worker_count]: Worker count for the new world. 0 uses the serial
//   single-worker fallback.
func m.create_world_from_snapshot(image, size, worker_count){}

// create_body(world_id: WorldId, def?: BodyDef) -> BodyId
// Create a rigid body given a definition. No reference to the definition is
// retained. So you can create the definition on the stack and pass it as a
// pointer. Warning: This function is locked during callbacks.
// C: `b2BodyId b2CreateBody(b2WorldId worldId, const b2BodyDef *def)`
func m.create_body(world_id, def){}

// destroy_body(body_id: BodyId)
// Destroy a rigid body given an id. This destroys all shapes and joints
// attached to the body. Do not keep references to the associated shapes and
// joints.
// C: `void b2DestroyBody(b2BodyId bodyId)`
func m.destroy_body(body_id){}

// body_is_valid(id: BodyId) -> bool
// Body identifier validation. A valid body exists in a world and is non-null.
// This can be used to detect orphaned ids. Provides validation for up to 64K
// allocations.
// C: `bool b2Body_IsValid(b2BodyId id)`
func m.body_is_valid(id){}

// body_get_type(body_id: BodyId) -> int
// Get the body type: static, kinematic, or dynamic
