// Get xyz-rotation matrix NOTE: Angle must be provided in radians
//   rotate_xyz(angle: Vector3) -> Matrix
//   C: Matrix MatrixRotateXYZ(Vector3 angle)
func ns_matrix_fns.rotate_xyz(angle){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get y-rotation matrix NOTE: Angle must be provided in radians
//   rotate_y(angle: float) -> Matrix
//   C: Matrix MatrixRotateY(float angle)
func ns_matrix_fns.rotate_y(angle){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get z-rotation matrix NOTE: Angle must be provided in radians
//   rotate_z(angle: float) -> Matrix
//   C: Matrix MatrixRotateZ(float angle)
func ns_matrix_fns.rotate_z(angle){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get zyx-rotation matrix NOTE: Angle must be provided in radians
//   rotate_zyx(angle: Vector3) -> Matrix
//   C: Matrix MatrixRotateZYX(Vector3 angle)
func ns_matrix_fns.rotate_zyx(angle){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get scaling matrix
//   scale(x: float, y: float, z: float) -> Matrix
//   C: Matrix MatrixScale(float x, float y, float z)
func ns_matrix_fns.scale(x, y, z){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Subtract two matrices (left - right)
//   subtract(left: Matrix, right: Matrix) -> Matrix
//   C: Matrix MatrixSubtract(Matrix left, Matrix right)
func ns_matrix_fns.subtract(left, right){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Get float array of matrix data
//   to_float_v(mat: Matrix) -> float16
//   C: float16 MatrixToFloatV(Matrix mat)
func ns_matrix_fns.to_float_v(mat){ return {v: {}} }

// Get the trace of the matrix (sum of the values along the diagonal)
//   trace(mat: Matrix) -> float
//   C: float MatrixTrace(Matrix mat)
func ns_matrix_fns.trace(mat){}

// Get translation matrix
//   translate(x: float, y: float, z: float) -> Matrix
//   C: Matrix MatrixTranslate(float x, float y, float z)
func ns_matrix_fns.translate(x, y, z){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

// Transposes provided matrix
//   transpose(mat: Matrix) -> Matrix
//   C: Matrix MatrixTranspose(Matrix mat)
func ns_matrix_fns.transpose(mat){ return {m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0, m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0} }

