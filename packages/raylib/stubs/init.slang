//   ortho_normalize(v1: Vector3 (updated), v2: Vector3 (updated))
//   C: void Vector3OrthoNormalize(Vector3 *v1, Vector3 *v2)
func ns_vector3_fns.ortho_normalize(v1, v2){}

// Calculate one vector perpendicular vector
