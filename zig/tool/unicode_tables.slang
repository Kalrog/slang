// Generates zig/src/stdlib/unicode_tables.zig: the sets of code points
// slang/regex's \p{...} classes name, from the Unicode Character Database:
// the general categories (Lu, Nd, ...), the scripts (Greek, Han, ...) and
// the identifier properties XID_Start and XID_Continue.
//
//   bin/slang run zig/tool/unicode_tables.slang <ucd> <version>
//
// <ucd> is a directory with DerivedGeneralCategory.txt (the database's
// extracted/ folder), Scripts.txt and DerivedCoreProperties.txt of one
// version (https://www.unicode.org/Public/<version>/ucd/), <version> its
// number, which the tables carry.
local os = require("slang/os")
local str = require("slang/string")
local tbl = require("slang/table")

local arguments = args()
local dir = arguments[0]
local version = arguments[1]
if(dir == null or version == null){
  print(
    "usage: slang run zig/tool/unicode_tables.slang <ucd directory> <version>\n",
  )
  os.exit(1)
}

// the ranges of every value a file gives: "0041..005A ; Lu # ..." lines
local func read(file, wanted){
  local sets = {}
  local order = {}
  for(let local line in values(
    str.split(os.read_file(concat(dir, "/", file)), "\n"),
  )){
    local cut = str.index_of(line, "#")
    if(cut >= 0){
      line = str.substring(line, 0, cut)
    }
    local parts = str.split(line, ";")
    if(len(parts) >= 2){
      local name = str.trim(parts[1])
      if(wanted == null or wanted[name]){
        local range = str.split(str.trim(parts[0]), "..")
        local lo = str.parse_int(range[0], 16)
        local hi = lo
        if(len(range) > 1){
          hi = str.parse_int(range[1], 16)
        }
        if(sets[name] == null){
          sets[name] = {}
          append(order, name)
        }
        append(sets[name], {lo, hi})
      }
    }
  }
  local out = {}
  for(let local name in values(tbl.sort(order))){
    local ranges = tbl.sort(sets[name], func(a, b){
      return a[0] < b[0]
    })
    local merged = {}
    for(let local r in values(ranges)){
      local last = merged[len(merged) - 1]
      if(last != null and r[0] <= last[1] + 1){
        if(r[1] > last[1]){
          last[1] = r[1]
        }
      } else {
        append(merged, {r[0], r[1]})
      }
    }
    append(out, {name: name, ranges: merged})
  }
  return out
}

local tables = {}
for(let local t in values(read("DerivedGeneralCategory.txt", null))){
  append(tables, t)
}
for(let local t in values(read("Scripts.txt", null))){
  append(tables, t)
}
for(let local t in values(read("DerivedCoreProperties.txt", {
  XID_Start: true, XID_Continue: true
}))){
  append(tables, t)
}

local func hex(n){
  return str.format("0x%X", n)
}

local out = {
  concat(
    "//! The sets of code points slang/regex's \\p{...} classes name: the general",
  ),
  "//! categories, the scripts and XID_Start and XID_Continue of the Unicode",
  concat("//! Character Database ", version, "."),
  "//! Generated by zig/tool/unicode_tables.slang: do not edit.",
  "",
  concat("pub const version = \"", version, "\";"),
  "",
  "pub const Table = struct { name: []const u8, ranges: []const [2]u21 };",
  "",
  "pub const tables = [_]Table{",
}
local count = 0
for(let local t in values(tables)){
  append(out, concat("    .{ .name = \"", t.name, "\", .ranges = &.{"))
  local line = {}
  for(let local r in values(t.ranges)){
    append(line, concat(".{ ", hex(r[0]), ", ", hex(r[1]), " }"))
    if(len(line) == 4){
      append(out, concat("        ", str.join(line, ", "), ","))
      line = {}
    }
    count = count + 1
  }
  if(len(line) > 0){
    append(out, concat("        ", str.join(line, ", "), ","))
  }
  append(out, "    } },")
}
append(out, "};")
os.write_file(
  "zig/src/stdlib/unicode_tables.zig",
  concat(str.join(out, "\n"), "\n"),
)
print(
  "zig/src/stdlib/unicode_tables.zig: ", len(tables), " sets, ", count,
  " ranges\n"
)
