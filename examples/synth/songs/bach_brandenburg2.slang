// The first movement (Allegro) of the Brandenburg Concerto No. 2 in F
// major, BWV 1047, by Johann Sebastian Bach, recorded as nine synthesizer
// parts after the score: the four soloists (trumpet, recorder, oboe,
// violin) and the strings with the bass. The notes: the Mutopia Project's
// edition (no. 1680, from the Bach-Gesellschaft, vol. 19, 1871, typeset by
// Andy Vaught), placed in the public domain by its typesetter. Its trumpet
// part is written an octave below where Bach's high F trumpet sounds; it is
// moved up here.
//
//   slang run mixdown.slang songs/bach_brandenburg2.slang
//
// Every line has a little vibrato: osc 3, off in the mixer, runs as a slow
// LFO (RANGE LO, not following the keys) that the mod wheel sends to the
// oscillators' pitch.
local vibrato = {
  range3: "LO",
  wave3: "TRI",
  osc3_ctrl: 0,
  on3: 0,
  mod_mix: 0.0,
  osc_mod: 1,
  filter_mod: 0,
}

// a patch: the vibrato's settings and the part's own
local func patch(depth, rate, own){
  local p = {mod: depth, detune3: rate}
  for(let local e in entries(vibrato)){
    p[e[0]] = e[1]
  }
  for(let local e in entries(own)){
    p[e[0]] = e[1]
  }
  return p
}

return {
  title: "Brandenburg Concerto No. 2, I. Allegro",
  composer: "J. S. Bach",
  midi: "bach_brandenburg2_1.mid",
  voice: "top",
  // the score's 60 quarters a minute, faster: about 100
  speed: 1.7,
  live: "trumpet",
