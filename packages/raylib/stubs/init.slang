// ------------------------------------------------------------ rl.wave

// Copy a wave to a new wave
//   copy(wave: Wave) -> Wave
//   C: Wave WaveCopy(Wave wave)
func ns_wave_fns.copy(wave){ return {@meta: wave_meta, frame_count: 0, sample_rate: 0, sample_size: 0, channels: 0, data: null} }

// Crop a wave to defined frames range
//   crop(wave: Wave (updated), init_frame: int, final_frame: int)
//   C: void WaveCrop(Wave *wave, int initFrame, int finalFrame)
func ns_wave_fns.crop(wave, init_frame, final_frame){}

// Export wave data to file, returns true on success
//   export(wave: Wave, file_name: string) -> bool
//   C: bool ExportWave(Wave wave, const char *fileName)
func ns_wave_fns.export(wave, file_name){}

// Export wave sample data to code (.h), returns true on success
//   export_as_code(wave: Wave, file_name: string) -> bool
//   C: bool ExportWaveAsCode(Wave wave, const char *fileName)
func ns_wave_fns.export_as_code(wave, file_name){}

// Convert wave data to desired format
//   format(wave: Wave (updated), sample_rate: int, sample_size: int, channels:
//      int)
//   C: void WaveFormat(Wave *wave, int sampleRate, int sampleSize, int
//      channels)
func ns_wave_fns.format(wave, sample_rate, sample_size, channels){}

// Load wave data from file
//   load(file_name: string) -> Wave
//   C: Wave LoadWave(const char *fileName)
func ns_wave_fns.load(file_name){ return {@meta: wave_meta, frame_count: 0, sample_rate: 0, sample_size: 0, channels: 0, data: null} }

// Load wave from memory buffer, fileType refers to extension: i.e. '.wav'
//   load_from_memory(file_type: string, file_data: string) -> Wave
//   C: Wave LoadWaveFromMemory(const char *fileType, const unsigned char
//      *fileData, int dataSize)
func ns_wave_fns.load_from_memory(file_type, file_data){ return {@meta: wave_meta, frame_count: 0, sample_rate: 0, sample_size: 0, channels: 0, data: null} }

// Load samples data from wave as a 32bit float data array
//   load_samples(wave: Wave) -> pointer
//   C: float *LoadWaveSamples(Wave wave)
func ns_wave_fns.load_samples(wave){}

// Unload wave data
//   unload(wave: Wave)
//   C: void UnloadWave(Wave wave)
func ns_wave_fns.unload(wave){}

// Unload samples data loaded with LoadWaveSamples()
