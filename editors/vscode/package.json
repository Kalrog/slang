{
  "name": "slang-lang",
  "displayName": "slang",
  "description": "Highlighting, diagnostics, navigation and formatting for slang, from the slang language server",
  "version": "0.2.0",
  "publisher": "slang",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:slang", "workspaceContains:**/slang.project", "onDebugResolve:slang", "onDebugDynamicConfigurations:slang"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The language server runs the project's extensions while parsing; it starts only in trusted workspaces. Basic highlighting works everywhere."
    }
  },
  "contributes": {
    "configurationDefaults": {
      "[slang]": {
        "editor.defaultFormatter": "slang.slang-lang",
        "editor.formatOnSave": true
      }
    },
    "languages": [{
      "id": "slang",
      "aliases": ["slang"],
      "extensions": [".slang"],
      "filenames": ["slang.project"],
      "configuration": "./language-configuration.json"
    }],
    "snippets": [{ "language": "slang", "path": "./snippets/slang.json" }],
    "commands": [
      { "command": "slang.runFile", "title": "Run File", "category": "slang", "icon": "$(play)" },
      { "command": "slang.debugFile", "title": "Debug File", "category": "slang", "icon": "$(debug-alt)" },
      { "command": "slang.repl", "title": "Open REPL", "category": "slang" },
      { "command": "slang.sendToRepl", "title": "Send Selection to REPL", "category": "slang" },
      { "command": "slang.showExpanded", "title": "Show Expanded Code", "category": "slang", "icon": "$(open-preview)" },
      { "command": "slang.get", "title": "Fetch Packages (slang get)", "category": "slang" },
      { "command": "slang.update", "title": "Update Packages (slang update)", "category": "slang" },
      { "command": "slang.build", "title": "Build Executable (slang build)", "category": "slang" },
      { "command": "slang.buildDir", "title": "Build Executable Directory (slang build --dir)", "category": "slang" }
    ],
    "menus": {
      "editor/title": [
        { "command": "slang.runFile", "when": "editorLangId == slang", "group": "navigation" },
        { "command": "slang.debugFile", "when": "editorLangId == slang", "group": "navigation" },
        { "command": "slang.showExpanded", "when": "editorLangId == slang", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "slang.sendToRepl", "when": "editorLangId == slang", "group": "slang" },
        { "command": "slang.showExpanded", "when": "editorLangId == slang", "group": "slang" }
      ],
      "commandPalette": [
        { "command": "slang.runFile", "when": "editorLangId == slang" },
        { "command": "slang.debugFile", "when": "editorLangId == slang" },
        { "command": "slang.sendToRepl", "when": "editorLangId == slang" },
        { "command": "slang.showExpanded", "when": "editorLangId == slang" }
      ]
    },
    "keybindings": [
      { "command": "slang.sendToRepl", "key": "shift+enter", "when": "editorTextFocus && editorLangId == slang" }
    ],
    "breakpoints": [{ "language": "slang" }],
    "debuggers": [
      {
        "type": "slang",
        "label": "slang",
        "languages": ["slang"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": { "type": "string", "description": "The file to run (or test)", "default": "${file}" },
              "args": { "type": "array", "items": { "type": "string" }, "description": "Arguments: the program's, or those of the command", "default": [] },
              "command": { "type": "string", "enum": ["run", "test"], "description": "run the program, or its tests with slang test", "default": "run" },
              "cwd": { "type": "string", "description": "The working directory", "default": "${workspaceFolder}" },
              "stopOnEntry": { "type": "boolean", "description": "Stop at the first line", "default": false }
            }
          }
        },
        "initialConfigurations": [
          { "type": "slang", "request": "launch", "name": "Debug the current file", "program": "${file}" }
        ],
        "configurationSnippets": [
          {
            "label": "slang: Debug a file",
            "body": { "type": "slang", "request": "launch", "name": "Debug ${1:main}", "program": "^\"\\${workspaceFolder}/${1:main}.slang\"" }
          },
          {
            "label": "slang: Debug the tests of a file",
            "body": { "type": "slang", "request": "launch", "name": "Debug the tests", "command": "test", "program": "^\"\\${file}\"" }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "slang",
        "required": ["command"],
        "properties": {
          "command": { "type": "string", "description": "The slang command: test, build, run, ..." },
          "args": { "type": "array", "items": { "type": "string" }, "description": "Its arguments" }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "slang",
        "owner": "slang",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          { "regexp": "^error: (.*)$", "message": 1 },
          { "regexp": "^\\s+at ([^:\\s\\[]+\\.slang):(\\d+):(\\d+)$", "file": 1, "line": 2, "column": 3 }
        ]
      },
      {
        "name": "slang-test",
        "owner": "slang",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": { "regexp": "^\\s+Error: (.*) @(.+\\.slang):(\\d+):(\\d+)$", "message": 1, "file": 2, "line": 3, "column": 4 }
      }
    ],
    "grammars": [{
      "language": "slang",
      "scopeName": "source.slang",
      "path": "./syntaxes/slang.tmLanguage.json"
    }],
    "semanticTokenTypes": [
      { "id": "punctuation", "superType": "operator", "description": "Brackets, commas, assignment" }
    ],
    "semanticTokenScopes": [{
      "language": "slang",
      "scopes": {
        "keyword": ["keyword.control.slang"],
        "keyword.declaration": ["storage.type.slang"],
        "keyword.readonly": ["constant.language.slang"],
        "variable": ["variable.other.slang"],
        "number": ["constant.numeric.slang"],
        "string": ["string.quoted.slang"],
        "comment": ["comment.line.slang"],
        "operator": ["keyword.operator.slang"],
        "punctuation": ["punctuation.slang"]
      }
    }],
    "configuration": {
      "title": "slang",
      "properties": {
        "slang.path": {
          "type": "string",
          "default": "slang",
          "description": "The slang binary used to run the language server: slang on the PATH, or a path such as ${workspaceFolder}/bin/slang."
        },
        "slang.associateDialects": {
          "type": "boolean",
          "default": true,
          "description": "Associate the dialect file suffixes of the project's slang.project with the slang language (updates files.associations in the workspace)."
        },
        "slang.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace the messages between VS Code and the slang language server."
        },
        "slang.parameterHints": {
          "type": "string",
          "enum": ["literals", "all", "none"],
          "default": "literals",
          "description": "Which call arguments get their parameter's name as an inlay hint: literal arguments (numbers, strings, true, false, null), all arguments, or none. Takes effect when the language server restarts."
        },
        "slang.lint": {
          "type": "boolean",
          "default": true,
          "description": "Report locals that are never used, globals no file of the project defines, and requires of modules that do not exist. Takes effect when the language server restarts."
        }
      }
    }
  },
  "scripts": {
    "bundle-lsp": "rm -rf lsp && mkdir lsp && cp ../../lsp/*.slang lsp/",
    "compile": "npm run bundle-lsp && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "package": "npm run compile && vsce package --allow-missing-repository --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.4.0"
  }
}
