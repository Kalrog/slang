//   C: Vector3 Vector3Invert(Vector3 v)
func ns_vector3_fns.invert(v){ return {x: 0, y: 0, z: 0} }

// Calculate vector length
//   length(v: Vector3) -> float
//   C: float Vector3Length(const Vector3 v)
func ns_vector3_fns.length(v){}

// Calculate vector square length
