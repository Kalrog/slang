// media r: ratio of the refractive index of the medium from where the ray comes
// to the refractive index of the medium on the other side of the surface
//   refract(v: Vector3, n: Vector3, r: float) -> Vector3
//   C: Vector3 Vector3Refract(Vector3 v, Vector3 n, float r)
func ns_vector3_fns.refract(v, n, r){ return {x: 0, y: 0, z: 0} }

// Calculate the rejection of the vector v1 on to v2
