// to_vec2(p: Vec2) -> Vec2
// Lossy conversion of a world position to a float vector. No-op in single
// precision.
// C: `b2Vec2 b2ToVec2(b2Vec2 p)`
func m.to_vec2(p){}

// round_down_float(x: float) -> float
// Narrow a world coordinate to float, rounding toward negative infinity. Use
// with b2RoundUpFloat to build a conservative float box that always contains
// double bounds, where plain rounding far from the origin could clip.
// nextafterf is an exact IEEE operation, so this is cross-platform
// deterministic. With large world mode off this is a plain conversion.
// C: `float b2RoundDownFloat(double x)`
func m.round_down_float(x){}

// round_up_float(x: float) -> float
// Narrow a world coordinate to float, rounding toward positive infinity.
// C: `float b2RoundUpFloat(double x)`
func m.round_up_float(x){}

// sub_pos(a: Vec2, b: Vec2) -> Vec2
