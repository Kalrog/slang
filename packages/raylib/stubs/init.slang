func m.matrix_perspective(fov_y, aspect, near_plane, far_plane){
  return {
    m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0,
    m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0
  }
}

// Get orthographic projection matrix
//   matrix_ortho(left: float, right: float, bottom: float, top: float,
//      near_plane: float, far_plane: float) -> Matrix
//   C: Matrix MatrixOrtho(double left, double right, double bottom, double top,
//      double nearPlane, double farPlane)
func m.matrix_ortho(left, right, bottom, top, near_plane, far_plane){
  return {
    m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0,
    m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0
  }
}

// Get camera look-at matrix (view matrix)
//   matrix_look_at(eye: Vector3, target: Vector3, up: Vector3) -> Matrix
//   C: Matrix MatrixLookAt(Vector3 eye, Vector3 target, Vector3 up)
func m.matrix_look_at(eye, target, up){
  return {
    m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0,
    m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0
  }
}

// Get float array of matrix data
//   matrix_to_float_v(mat: Matrix) -> float16
//   C: float16 MatrixToFloatV(Matrix mat)
func m.matrix_to_float_v(mat){ return {v: {}} }

// Add two quaternions
//   quaternion_add(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionAdd(Vector4 q1, Vector4 q2)
func m.quaternion_add(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Add quaternion and float value
//   quaternion_add_value(q: Vector4, add: float) -> Vector4
//   C: Vector4 QuaternionAddValue(Vector4 q, float add)
func m.quaternion_add_value(q, add){ return {x: 0, y: 0, z: 0, w: 0} }

// Subtract two quaternions
//   quaternion_subtract(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionSubtract(Vector4 q1, Vector4 q2)
func m.quaternion_subtract(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Subtract quaternion and float value
//   quaternion_subtract_value(q: Vector4, sub: float) -> Vector4
//   C: Vector4 QuaternionSubtractValue(Vector4 q, float sub)
func m.quaternion_subtract_value(q, sub){ return {x: 0, y: 0, z: 0, w: 0} }

// Get identity quaternion
//   quaternion_identity() -> Vector4
//   C: Vector4 QuaternionIdentity()
func m.quaternion_identity(){ return {x: 0, y: 0, z: 0, w: 0} }

// Computes the length of a quaternion
//   quaternion_length(q: Vector4) -> float
//   C: float QuaternionLength(Vector4 q)
func m.quaternion_length(q){}

// Normalize provided quaternion
//   quaternion_normalize(q: Vector4) -> Vector4
//   C: Vector4 QuaternionNormalize(Vector4 q)
func m.quaternion_normalize(q){ return {x: 0, y: 0, z: 0, w: 0} }

// Invert provided quaternion
//   quaternion_invert(q: Vector4) -> Vector4
//   C: Vector4 QuaternionInvert(Vector4 q)
func m.quaternion_invert(q){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate two quaternion multiplication
//   quaternion_multiply(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionMultiply(Vector4 q1, Vector4 q2)
func m.quaternion_multiply(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Scale quaternion by float value
//   quaternion_scale(q: Vector4, mul: float) -> Vector4
//   C: Vector4 QuaternionScale(Vector4 q, float mul)
func m.quaternion_scale(q, mul){ return {x: 0, y: 0, z: 0, w: 0} }

// Divide two quaternions
//   quaternion_divide(q1: Vector4, q2: Vector4) -> Vector4
//   C: Vector4 QuaternionDivide(Vector4 q1, Vector4 q2)
func m.quaternion_divide(q1, q2){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate linear interpolation between two quaternions
//   quaternion_lerp(q1: Vector4, q2: Vector4, amount: float) -> Vector4
//   C: Vector4 QuaternionLerp(Vector4 q1, Vector4 q2, float amount)
func m.quaternion_lerp(q1, q2, amount){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate slerp-optimized interpolation between two quaternions
//   quaternion_nlerp(q1: Vector4, q2: Vector4, amount: float) -> Vector4
//   C: Vector4 QuaternionNlerp(Vector4 q1, Vector4 q2, float amount)
func m.quaternion_nlerp(q1, q2, amount){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculates spherical linear interpolation between two quaternions
//   quaternion_slerp(q1: Vector4, q2: Vector4, amount: float) -> Vector4
//   C: Vector4 QuaternionSlerp(Vector4 q1, Vector4 q2, float amount)
func m.quaternion_slerp(q1, q2, amount){ return {x: 0, y: 0, z: 0, w: 0} }

// Calculate quaternion cubic spline interpolation using Cubic Hermite Spline
// algorithm as described in the GLTF 2.0 specification:
// https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
//   quaternion_cubic_hermite_spline(q1: Vector4, out_tangent1: Vector4, q2:
//      Vector4, in_tangent2: Vector4, t: float) -> Vector4
//   C: Vector4 QuaternionCubicHermiteSpline(Vector4 q1, Vector4 outTangent1,
//      Vector4 q2, Vector4 inTangent2, float t)
func m.quaternion_cubic_hermite_spline(q1, out_tangent1, q2, in_tangent2, t){
  return {x: 0, y: 0, z: 0, w: 0}
}

// Calculate quaternion based on the rotation from one vector to another
//   quaternion_from_vector3_to_vector3(from: Vector3, to: Vector3) -> Vector4
//   C: Vector4 QuaternionFromVector3ToVector3(Vector3 from, Vector3 to)
func m.quaternion_from_vector3_to_vector3(from, to){
  return {x: 0, y: 0, z: 0, w: 0}
}

// Get a quaternion for a given rotation matrix
//   quaternion_from_matrix(mat: Matrix) -> Vector4
//   C: Vector4 QuaternionFromMatrix(Matrix mat)
func m.quaternion_from_matrix(mat){ return {x: 0, y: 0, z: 0, w: 0} }

// Get a matrix for a given quaternion
//   quaternion_to_matrix(q: Vector4) -> Matrix
//   C: Matrix QuaternionToMatrix(Vector4 q)
func m.quaternion_to_matrix(q){
  return {
    m0: 0, m4: 0, m8: 0, m12: 0, m1: 0, m5: 0, m9: 0, m13: 0, m2: 0, m6: 0,
    m10: 0, m14: 0, m3: 0, m7: 0, m11: 0, m15: 0
  }
}

// Get rotation quaternion for an angle and axis NOTE: Angle must be provided in
// radians
//   quaternion_from_axis_angle(axis: Vector3, angle: float) -> Vector4
//   C: Vector4 QuaternionFromAxisAngle(Vector3 axis, float angle)
func m.quaternion_from_axis_angle(axis, angle){
  return {x: 0, y: 0, z: 0, w: 0}
}

// Get the rotation angle and axis for a given quaternion
//   quaternion_to_axis_angle(q: Vector4, out_axis: Vector3 (updated),
//      out_angle: pointer)
//   C: void QuaternionToAxisAngle(Vector4 q, Vector3 *outAxis, float *outAngle)
func m.quaternion_to_axis_angle(q, out_axis, out_angle){}

// Get the quaternion equivalent to Euler angles NOTE: Rotation order is ZYX
//   quaternion_from_euler(pitch: float, yaw: float, roll: float) -> Vector4
//   C: Vector4 QuaternionFromEuler(float pitch, float yaw, float roll)
func m.quaternion_from_euler(pitch, yaw, roll){
  return {x: 0, y: 0, z: 0, w: 0}
}

// Get the Euler angles equivalent to quaternion (roll, pitch, yaw) NOTE: Angles
// are returned in a Vector3 struct in radians
//   quaternion_to_euler(q: Vector4) -> Vector3
//   C: Vector3 QuaternionToEuler(Vector4 q)
func m.quaternion_to_euler(q){ return {x: 0, y: 0, z: 0} }

// Transform a quaternion given a transformation matrix
//   quaternion_transform(q: Vector4, mat: Matrix) -> Vector4
//   C: Vector4 QuaternionTransform(Vector4 q, Matrix mat)
func m.quaternion_transform(q, mat){ return {x: 0, y: 0, z: 0, w: 0} }

// Check whether two given quaternions are almost equal
//   quaternion_equals(p: Vector4, q: Vector4) -> int
//   C: int QuaternionEquals(Vector4 p, Vector4 q)
func m.quaternion_equals(p, q){}

// Decompose a transformation matrix into its rotational, translational and
// scaling components
//   matrix_decompose(mat: Matrix, translation: Vector3 (updated), rotation:
//      Vector4 (updated), scale: Vector3 (updated))
//   C: void MatrixDecompose(Matrix mat, Vector3 *translation, Vector4
//      *rotation, Vector3 *scale)
func m.matrix_decompose(mat, translation, rotation, scale){}

