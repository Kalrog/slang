// a test module: a struct, a constant, a helper and two kernels
struct Osc { phase: double, inc: double, gain: float }

local HALF = 0.5

func wrap(x: float): float {
  return x - floor(x)
}

kernel func saws(out: float[], oscs: Osc[], n: int){
  for(local i = 0; i < n; i += 1){
    local s = 0.0
    for(local k = 0; k < len(oscs); k += 1){
      local o = oscs[k]
      o.phase = wrap(o.phase + o.inc)
      s += (o.phase * 2 - 1) * o.gain
    }
    out[i] = s * HALF
  }
}

kernel func total(osc: Osc): float {
  return osc.phase + osc.inc
}
