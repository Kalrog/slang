// ------------------------------------------------------------ functions

// Initialize window and OpenGL context
//   init_window(width: int, height: int, title: string)
//   C: void InitWindow(int width, int height, const char *title)
func m.init_window(width, height, title){}

// Close window and unload OpenGL context
//   close_window()
//   C: void CloseWindow()
func m.close_window(){}

// Check if application should close (KEY_ESCAPE pressed or windows close icon
// clicked)
//   window_should_close() -> bool
//   C: bool WindowShouldClose()
func m.window_should_close(){}

// Check if window has been initialized successfully
//   is_window_ready() -> bool
//   C: bool IsWindowReady()
func m.is_window_ready(){}

// Check if window is currently fullscreen
//   is_window_fullscreen() -> bool
//   C: bool IsWindowFullscreen()
func m.is_window_fullscreen(){}

// Check if window is currently hidden
//   is_window_hidden() -> bool
//   C: bool IsWindowHidden()
func m.is_window_hidden(){}

// Check if window is currently minimized
//   is_window_minimized() -> bool
//   C: bool IsWindowMinimized()
func m.is_window_minimized(){}

// Check if window is currently maximized
//   is_window_maximized() -> bool
//   C: bool IsWindowMaximized()
func m.is_window_maximized(){}

// Check if window is currently focused
//   is_window_focused() -> bool
//   C: bool IsWindowFocused()
func m.is_window_focused(){}

// Check if window has been resized last frame
//   is_window_resized() -> bool
//   C: bool IsWindowResized()
func m.is_window_resized(){}

// Check if one specific window flag is enabled
//   is_window_state(flag: int) -> bool
//   C: bool IsWindowState(unsigned int flag)
func m.is_window_state(flag){}

// Set window configuration state using flags
//   set_window_state(flags: int)
//   C: void SetWindowState(unsigned int flags)
func m.set_window_state(flags){}

// Clear window configuration state flags
//   clear_window_state(flags: int)
//   C: void ClearWindowState(unsigned int flags)
func m.clear_window_state(flags){}

// Toggle window state: fullscreen/windowed, resizes monitor to match window
// resolution
//   toggle_fullscreen()
//   C: void ToggleFullscreen()
func m.toggle_fullscreen(){}

// Toggle window state: borderless windowed, resizes window to match monitor
// resolution
//   toggle_borderless_windowed()
//   C: void ToggleBorderlessWindowed()
func m.toggle_borderless_windowed(){}

// Set window state: maximized, if resizable
//   maximize_window()
//   C: void MaximizeWindow()
func m.maximize_window(){}

// Set window state: minimized, if resizable
//   minimize_window()
//   C: void MinimizeWindow()
func m.minimize_window(){}

// Set window state: not minimized/maximized
//   restore_window()
//   C: void RestoreWindow()
func m.restore_window(){}

// Set icon for window (single image, RGBA 32bit)
//   set_window_icon(image: Image)
//   C: void SetWindowIcon(Image image)
func m.set_window_icon(image){}

// Set icon for window (multiple images, RGBA 32bit)
//   set_window_icons(images: list of Image)
//   C: void SetWindowIcons(Image *images, int count)
func m.set_window_icons(images){}

// Set title for window
//   set_window_title(title: string)
//   C: void SetWindowTitle(const char *title)
func m.set_window_title(title){}

// Set window position on screen
//   set_window_position(x: int, y: int)
//   C: void SetWindowPosition(int x, int y)
func m.set_window_position(x, y){}

// Set monitor for the current window
//   set_window_monitor(monitor: int)
//   C: void SetWindowMonitor(int monitor)
func m.set_window_monitor(monitor){}

// Set window minimum dimensions (for FLAG_WINDOW_RESIZABLE)
//   set_window_min_size(width: int, height: int)
//   C: void SetWindowMinSize(int width, int height)
func m.set_window_min_size(width, height){}

// Set window maximum dimensions (for FLAG_WINDOW_RESIZABLE)
//   set_window_max_size(width: int, height: int)
//   C: void SetWindowMaxSize(int width, int height)
func m.set_window_max_size(width, height){}

// Set window dimensions
//   set_window_size(width: int, height: int)
//   C: void SetWindowSize(int width, int height)
func m.set_window_size(width, height){}

// Set window opacity [0.0f..1.0f]
//   set_window_opacity(opacity: float)
//   C: void SetWindowOpacity(float opacity)
func m.set_window_opacity(opacity){}

// Set window focused
//   set_window_focused()
//   C: void SetWindowFocused()
func m.set_window_focused(){}

// Get native window handle
//   get_window_handle() -> pointer
//   C: void *GetWindowHandle()
func m.get_window_handle(){}

// Get current screen width
//   get_screen_width() -> int
//   C: int GetScreenWidth()
func m.get_screen_width(){}

// Get current screen height
//   get_screen_height() -> int
//   C: int GetScreenHeight()
func m.get_screen_height(){}

// Get current render width (it considers HiDPI)
//   get_render_width() -> int
//   C: int GetRenderWidth()
func m.get_render_width(){}

// Get current render height (it considers HiDPI)
//   get_render_height() -> int
//   C: int GetRenderHeight()
func m.get_render_height(){}

// Get number of connected monitors
//   get_monitor_count() -> int
//   C: int GetMonitorCount()
func m.get_monitor_count(){}

// Get current monitor where window is placed
//   get_current_monitor() -> int
//   C: int GetCurrentMonitor()
func m.get_current_monitor(){}

// Get specified monitor position
//   get_monitor_position(monitor: int) -> Vector2
//   C: Vector2 GetMonitorPosition(int monitor)
func m.get_monitor_position(monitor){ return {x: 0, y: 0} }

// Get specified monitor width (current video mode used by monitor)
//   get_monitor_width(monitor: int) -> int
//   C: int GetMonitorWidth(int monitor)
func m.get_monitor_width(monitor){}

// Get specified monitor height (current video mode used by monitor)
//   get_monitor_height(monitor: int) -> int
//   C: int GetMonitorHeight(int monitor)
func m.get_monitor_height(monitor){}

// Get specified monitor physical width in millimetres
//   get_monitor_physical_width(monitor: int) -> int
