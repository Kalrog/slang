// create_chain_segment_shape(body_id: BodyId, def?: ShapeDef, chain_segment:
//   ChainSegment) -> ShapeId
// Create a chain segment shape and attach it to a body. The shape definition
// and geometry are fully cloned. The segment is not owned by any chain shape
// (b2Shape_GetParentChain returns b2_nullChainId). Contacts are not created
