// (a, b, c) NOTE: Assumes P is on the plane of the triangle
//   barycenter(p: Vector3, a: Vector3, b: Vector3, c: Vector3) -> Vector3
//   C: Vector3 Vector3Barycenter(Vector3 p, Vector3 a, Vector3 b, Vector3 c)
func ns_vector3_fns.barycenter(p, a, b, c){ return {x: 0, y: 0, z: 0} }

// Clamp the components of the vector between min and max values specified by
// the given vectors
//   clamp(v: Vector3, min: Vector3, max: Vector3) -> Vector3
//   C: Vector3 Vector3Clamp(Vector3 v, Vector3 min, Vector3 max)
func ns_vector3_fns.clamp(v, min, max){ return {x: 0, y: 0, z: 0} }

// Clamp the magnitude of the vector between two values
//   clamp_value(v: Vector3, min: float, max: float) -> Vector3
//   C: Vector3 Vector3ClampValue(Vector3 v, float min, float max)
func ns_vector3_fns.clamp_value(v, min, max){ return {x: 0, y: 0, z: 0} }

