// The C file that gives slang/ffi the symbols of the libraries linked into
// the Emscripten build (raylib, raymath, Box2D, joltc): `slang run
// website/web/symbols.slang out.c defined.txt header...`. Every function the
// headers declare with the libraries' API macros (RLAPI, RMAPI, B2_API,
// JPH_CAPI) that a library defines (defined.txt: the names emnm lists, one
// per line) gets an entry; the others (GetClipboardImage on the web) are
// left out, and slang/ffi reports them when they are called. raylib
// compiles raymath's functions itself; the header's inline declarations
// refer to those.
local os = require("slang/os")
local str = require("slang/string")

local arguments = args()
local out = arguments[0]
local defined = {}
for(let local line in values(str.split(os.read_file(arguments[1]), "\n"))){
  defined[str.trim(line)] = true
}
local names = {}
local seen = {}
for(local i = 2; i < len(arguments); i = i + 1){
  for(let local line in values(str.split(os.read_file(arguments[i]), "\n"))){
    local l = str.trim(line)
    if(str.starts_with(l, "RLAPI ") or str.starts_with(l, "RMAPI ") or
      str.starts_with(l, "B2_API ") or str.starts_with(l, "JPH_CAPI ")){
      local open = str.index_of(l, "(")
      if(open > 0){
        // the name: the word before the parenthesis (after any *)
        local j = open
        for(j > 0 and str.byte_at(l, j - 1) == 32){
          j = j - 1
        }
        local k = j
        for(k > 0 and str.byte_at(l, k - 1) != 32 and
          str.byte_at(l, k - 1) != 42){
          k = k - 1
        }
        local name = str.substring(l, k, j)
        if(not seen[name] and defined[name]){
          seen[name] = true
          append(names, name)
        }
      }
    }
  }
}

local lines = {
  "// generated by website/web/symbols.slang: the symbols slang/ffi finds",
  "#include <string.h>",
}
for(local i = 2; i < len(arguments); i = i + 1){
  append(lines, concat("#include \"", arguments[i], "\""))
}
append(lines, "")
append(lines, "static const struct { const char *name; void *ptr; } symbols[] = {")
for(let local n in values(names)){
  append(lines, concat("  {\"", n, "\", (void *)", n, "},"))
}
append(lines, "  {0, 0}")
append(lines, "};")
append(lines, "")
append(lines, "void *slang_ffi_static_symbol(const char *name) {")
append(lines, "  for (int i = 0; symbols[i].name; i++)")
append(
  lines,
  "    if (strcmp(symbols[i].name, name) == 0) return symbols[i].ptr;",
)
append(lines, "  return 0;")
append(lines, "}")
os.write_file(out, concat(str.join(lines, "\n"), "\n"))
print(len(names), " symbols in ", out, "\n")
