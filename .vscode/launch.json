{
  // Runs the slang binary from the workspace root under lldb-dap, so
  // `require` resolves paths the same way as on the command line.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Current File",
      "type": "slang",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
    },
    {
      "name": "Build Website",
      "type": "slang",
      "request": "launch",
      "program": "${workspaceFolder}/website/build.slang",
      "cwd": "${workspaceFolder}"
    }
  ]
}